import greet (greet)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('passes', fn (t) { t.equal(greet('you'), 'Hello, you!') })
  t.test('fails on a string', fn (t) { t.equal(greet('you'), 'nope') })
  t.test('fails twice', fn (t) {
    t.equal(1 + 1, 3)
    t.true(false)
  })
  t.test('multi-line value', fn (t) { t.equal(greet('a\nb'), 'x') })
}
