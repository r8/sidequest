(defn square-of-sum
  "(square-of-sum n) -> the square of the sum of 1..n"
  [n]
  (error "implement me"))

(defn sum-of-squares
  "(sum-of-squares n) -> the sum of the squares of 1..n"
  [n]
  (error "implement me"))

(defn difference-of-squares
  "(difference-of-squares n) -> (square-of-sum n) minus (sum-of-squares n)"
  [n]
