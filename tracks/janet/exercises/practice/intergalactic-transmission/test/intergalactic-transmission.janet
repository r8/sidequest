(import test :as t)
(import ../intergalactic-transmission :as sol)

(t/deftest "empty message"
  (t/assert-equal [] (sol/transmit-sequence [])))

(t/deftest "0x00 is transmitted as 0x0000"
  (t/assert-equal [0x00 0x00] (sol/transmit-sequence [0x00])))

(t/deftest "0x02 is transmitted as 0x0300"
  (t/assert-equal [0x03 0x00] (sol/transmit-sequence [0x02])))

(t/deftest "0x06 is transmitted as 0x0600"
  (t/assert-equal [0x06 0x00] (sol/transmit-sequence [0x06])))

(t/deftest "0x05 is transmitted as 0x0581"
  (t/assert-equal [0x05 0x81] (sol/transmit-sequence [0x05])))

(t/deftest "0x29 is transmitted as 0x2881"
  (t/assert-equal [0x28 0x81] (sol/transmit-sequence [0x29])))

(t/deftest "0xc001c0de is transmitted as 0xc000711be1"
  (t/assert-equal [0xc0 0x00 0x71 0x1b 0xe1] (sol/transmit-sequence [0xc0 0x01 0xc0 0xde])))

(t/deftest "six byte message"
  (t/assert-equal [0x47 0xb8 0x99 0xac 0x17 0xa0 0x84] (sol/transmit-sequence [0x47 0x72 0x65 0x61 0x74 0x21])))

(t/deftest "seven byte message"
  (t/assert-equal [0x47 0xb8 0x99 0xac 0x17 0xa0 0xc5 0x42] (sol/transmit-sequence [0x47 0x72 0x65 0x61 0x74 0x31 0x21])))

(t/deftest "eight byte message"
  (t/assert-equal [0xc0 0x00 0x44 0x66 0x7d 0x06 0x78 0x42 0x21 0x81] (sol/transmit-sequence [0xc0 0x01 0x13 0x37 0xc0 0xde 0x21 0x21])))

(t/deftest "twenty byte message"
  (t/assert-equal [0x44 0xbd 0x18 0xaf 0x27 0x1b 0xa5 0xe7 0x6c 0x90 0x1b 0x2e 0x33 0x03 0x84 0xee 0x65 0xb8 0xdb 0xed 0xd7 0x28 0x84] (sol/transmit-sequence [0x45 0x78 0x65 0x72 0x63 0x69 0x73 0x6d 0x20 0x69 0x73 0x20 0x61 0x77 0x65 0x73 0x6f 0x6d 0x65 0x21])))

(t/deftest "decode received messages > empty message"
  (t/assert-equal [] (sol/decode-message [])))

(t/deftest "zero message"
  (t/assert-equal [0x00] (sol/decode-message [0x00 0x00])))

(t/deftest "0x0300 is decoded to 0x02"
  (t/assert-equal [0x02] (sol/decode-message [0x03 0x00])))

(t/deftest "0x0581 is decoded to 0x05"
  (t/assert-equal [0x05] (sol/decode-message [0x05 0x81])))

(t/deftest "0x2881 is decoded to 0x29"
  (t/assert-equal [0x29] (sol/decode-message [0x28 0x81])))

(t/deftest "first byte has wrong parity"
  (t/assert-error "wrong parity" (sol/decode-message [0x07 0x00])))

(t/deftest "second byte has wrong parity"
  (t/assert-error "wrong parity" (sol/decode-message [0x03 0x68])))

(t/deftest "0xcf4b00 is decoded to 0xce94"
  (t/assert-equal [0xce 0x94] (sol/decode-message [0xcf 0x4b 0x00])))

(t/deftest "0xe2566500 is decoded to 0xe2ad90"
  (t/assert-equal [0xe2 0xad 0x90] (sol/decode-message [0xe2 0x56 0x65 0x00])))

(t/deftest "decode received messages > six byte message"
  (t/assert-equal [0x47 0x72 0x65 0x61 0x74 0x21] (sol/decode-message [0x47 0xb8 0x99 0xac 0x17 0xa0 0x84])))

(t/deftest "decode received messages > seven byte message"
  (t/assert-equal [0x47 0x72 0x65 0x61 0x74 0x31 0x21] (sol/decode-message [0x47 0xb8 0x99 0xac 0x17 0xa0 0xc5 0x42])))

(t/deftest "last byte has wrong parity"
  (t/assert-error "wrong parity" (sol/decode-message [0x47 0xb8 0x99 0xac 0x17 0xa0 0xc5 0x43])))

(t/deftest "decode received messages > eight byte message"
  (t/assert-equal [0xc0 0x01 0x13 0x37 0xc0 0xde 0x21 0x21] (sol/decode-message [0xc0 0x00 0x44 0x66 0x7d 0x06 0x78 0x42 0x21 0x81])))

(t/deftest "decode received messages > twenty byte message"
  (t/assert-equal [0x45 0x78 0x65 0x72 0x63 0x69 0x73 0x6d 0x20 0x69 0x73 0x20 0x61 0x77 0x65 0x73 0x6f 0x6d 0x65 0x21] (sol/decode-message [0x44 0xbd 0x18 0xaf 0x27 0x1b 0xa5 0xe7 0x6c 0x90 0x1b 0x2e 0x33 0x03 0x84 0xee 0x65 0xb8 0xdb 0xed 0xd7 0x28 0x84])))

(t/deftest "wrong parity on 16th byte"
  (t/assert-error "wrong parity" (sol/decode-message [0x44 0xbd 0x18 0xaf 0x27 0x1b 0xa5 0xe7 0x6c 0x90 0x1b 0x2e 0x33 0x03 0x84 0xef 0x65 0xb8 0xdb 0xed 0xd7 0x28 0x84])))

(t/run)
