(defn make-game
  "(make-game) -> a new game with no rolls yet"
  []
  (error "implement me"))

(defn roll
  "(roll game pins) -> game, after recording a roll that knocked down pins"
  [game pins]
  (error "implement me"))

(defn score
  "(score game) -> the total score of a finished game"
  [game]
  (error "implement me"))
