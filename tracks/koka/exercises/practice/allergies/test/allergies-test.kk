import test
import allergies

pub fun main()
  run([
    test("testing for eggs allergy > not allergic to anything") { assert-false(allergic-to(Eggs, 0)) },
    test("testing for eggs allergy > allergic only to eggs") { assert-true(allergic-to(Eggs, 1)) },
    test("testing for eggs allergy > allergic to eggs and something else") { assert-true(allergic-to(Eggs, 3)) },
    test("testing for eggs allergy > allergic to something, but not eggs") { assert-false(allergic-to(Eggs, 2)) },
    test("testing for eggs allergy > allergic to everything") { assert-true(allergic-to(Eggs, 255)) },
    test("testing for peanuts allergy > not allergic to anything") { assert-false(allergic-to(Peanuts, 0)) },
    test("testing for peanuts allergy > allergic only to peanuts") { assert-true(allergic-to(Peanuts, 2)) },
    test("testing for peanuts allergy > allergic to peanuts and something else") { assert-true(allergic-to(Peanuts, 7)) },
    test("testing for peanuts allergy > allergic to something, but not peanuts") { assert-false(allergic-to(Peanuts, 5)) },
    test("testing for peanuts allergy > allergic to everything") { assert-true(allergic-to(Peanuts, 255)) },
    test("testing for shellfish allergy > not allergic to anything") { assert-false(allergic-to(Shellfish, 0)) },
    test("testing for shellfish allergy > allergic only to shellfish") { assert-true(allergic-to(Shellfish, 4)) },
    test("testing for shellfish allergy > allergic to shellfish and something else") { assert-true(allergic-to(Shellfish, 14)) },
    test("testing for shellfish allergy > allergic to something, but not shellfish") { assert-false(allergic-to(Shellfish, 10)) },
    test("testing for shellfish allergy > allergic to everything") { assert-true(allergic-to(Shellfish, 255)) },
    test("testing for strawberries allergy > not allergic to anything") { assert-false(allergic-to(Strawberries, 0)) },
    test("testing for strawberries allergy > allergic only to strawberries") { assert-true(allergic-to(Strawberries, 8)) },
    test("testing for strawberries allergy > allergic to strawberries and something else") { assert-true(allergic-to(Strawberries, 28)) },
    test("testing for strawberries allergy > allergic to something, but not strawberries") { assert-false(allergic-to(Strawberries, 20)) },
    test("testing for strawberries allergy > allergic to everything") { assert-true(allergic-to(Strawberries, 255)) },
    test("testing for tomatoes allergy > not allergic to anything") { assert-false(allergic-to(Tomatoes, 0)) },
    test("testing for tomatoes allergy > allergic only to tomatoes") { assert-true(allergic-to(Tomatoes, 16)) },
    test("testing for tomatoes allergy > allergic to tomatoes and something else") { assert-true(allergic-to(Tomatoes, 56)) },
    test("testing for tomatoes allergy > allergic to something, but not tomatoes") { assert-false(allergic-to(Tomatoes, 40)) },
    test("testing for tomatoes allergy > allergic to everything") { assert-true(allergic-to(Tomatoes, 255)) },
    test("testing for chocolate allergy > not allergic to anything") { assert-false(allergic-to(Chocolate, 0)) },
    test("testing for chocolate allergy > allergic only to chocolate") { assert-true(allergic-to(Chocolate, 32)) },
    test("testing for chocolate allergy > allergic to chocolate and something else") { assert-true(allergic-to(Chocolate, 112)) },
    test("testing for chocolate allergy > allergic to something, but not chocolate") { assert-false(allergic-to(Chocolate, 80)) },
    test("testing for chocolate allergy > allergic to everything") { assert-true(allergic-to(Chocolate, 255)) },
    test("testing for pollen allergy > not allergic to anything") { assert-false(allergic-to(Pollen, 0)) },
    test("testing for pollen allergy > allergic only to pollen") { assert-true(allergic-to(Pollen, 64)) },
    test("testing for pollen allergy > allergic to pollen and something else") { assert-true(allergic-to(Pollen, 224)) },
    test("testing for pollen allergy > allergic to something, but not pollen") { assert-false(allergic-to(Pollen, 160)) },
    test("testing for pollen allergy > allergic to everything") { assert-true(allergic-to(Pollen, 255)) },
    test("testing for cats allergy > not allergic to anything") { assert-false(allergic-to(Cats, 0)) },
    test("testing for cats allergy > allergic only to cats") { assert-true(allergic-to(Cats, 128)) },
    test("testing for cats allergy > allergic to cats and something else") { assert-true(allergic-to(Cats, 192)) },
    test("testing for cats allergy > allergic to something, but not cats") { assert-false(allergic-to(Cats, 64)) },
    test("testing for cats allergy > allergic to everything") { assert-true(allergic-to(Cats, 255)) },
    test("list when: > no allergies") { assert-equal([], allergies(0)) },
    test("list when: > just eggs") { assert-equal([Eggs], allergies(1)) },
    test("list when: > just peanuts") { assert-equal([Peanuts], allergies(2)) },
    test("list when: > just strawberries") { assert-equal([Strawberries], allergies(8)) },
    test("list when: > eggs and peanuts") { assert-equal([Eggs, Peanuts], allergies(3)) },
    test("list when: > more than eggs but not peanuts") { assert-equal([Eggs, Shellfish], allergies(5)) },
    test("list when: > lots of stuff") { assert-equal([Strawberries, Tomatoes, Chocolate, Pollen, Cats], allergies(248)) },
    test("list when: > everything") { assert-equal([Eggs, Peanuts, Shellfish, Strawberries, Tomatoes, Chocolate, Pollen, Cats], allergies(255)) },
    test("list when: > no allergen score parts") { assert-equal([Eggs, Shellfish, Strawberries, Tomatoes, Chocolate, Pollen, Cats], allergies(509)) },
    test("list when: > no allergen score parts without highest valid score") { assert-equal([Eggs], allergies(257)) },
  ])
