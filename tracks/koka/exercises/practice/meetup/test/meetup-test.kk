import test
import meetup

pub fun main()
  run([
    test("when teenth Monday is the 13th, the first day of the teenth week") { assert-equal((2013, 5, 13), meetup(2013, 5, Teenth, Monday)) },
    test("when teenth Monday is the 19th, the last day of the teenth week") { assert-equal((2013, 8, 19), meetup(2013, 8, Teenth, Monday)) },
    test("when teenth Monday is some day in the middle of the teenth week") { assert-equal((2013, 9, 16), meetup(2013, 9, Teenth, Monday)) },
    test("when teenth Tuesday is the 19th, the last day of the teenth week") { assert-equal((2013, 3, 19), meetup(2013, 3, Teenth, Tuesday)) },
    test("when teenth Tuesday is some day in the middle of the teenth week") { assert-equal((2013, 4, 16), meetup(2013, 4, Teenth, Tuesday)) },
    test("when teenth Tuesday is the 13th, the first day of the teenth week") { assert-equal((2013, 8, 13), meetup(2013, 8, Teenth, Tuesday)) },
    test("when teenth Wednesday is some day in the middle of the teenth week") { assert-equal((2013, 1, 16), meetup(2013, 1, Teenth, Wednesday)) },
    test("when teenth Wednesday is the 13th, the first day of the teenth week") { assert-equal((2013, 2, 13), meetup(2013, 2, Teenth, Wednesday)) },
    test("when teenth Wednesday is the 19th, the last day of the teenth week") { assert-equal((2013, 6, 19), meetup(2013, 6, Teenth, Wednesday)) },
    test("when teenth Thursday is some day in the middle of the teenth week") { assert-equal((2013, 5, 16), meetup(2013, 5, Teenth, Thursday)) },
    test("when teenth Thursday is the 13th, the first day of the teenth week") { assert-equal((2013, 6, 13), meetup(2013, 6, Teenth, Thursday)) },
    test("when teenth Thursday is the 19th, the last day of the teenth week") { assert-equal((2013, 9, 19), meetup(2013, 9, Teenth, Thursday)) },
    test("when teenth Friday is the 19th, the last day of the teenth week") { assert-equal((2013, 4, 19), meetup(2013, 4, Teenth, Friday)) },
    test("when teenth Friday is some day in the middle of the teenth week") { assert-equal((2013, 8, 16), meetup(2013, 8, Teenth, Friday)) },
    test("when teenth Friday is the 13th, the first day of the teenth week") { assert-equal((2013, 9, 13), meetup(2013, 9, Teenth, Friday)) },
    test("when teenth Saturday is some day in the middle of the teenth week") { assert-equal((2013, 2, 16), meetup(2013, 2, Teenth, Saturday)) },
    test("when teenth Saturday is the 13th, the first day of the teenth week") { assert-equal((2013, 4, 13), meetup(2013, 4, Teenth, Saturday)) },
    test("when teenth Saturday is the 19th, the last day of the teenth week") { assert-equal((2013, 10, 19), meetup(2013, 10, Teenth, Saturday)) },
    test("when teenth Sunday is the 19th, the last day of the teenth week") { assert-equal((2013, 5, 19), meetup(2013, 5, Teenth, Sunday)) },
    test("when teenth Sunday is some day in the middle of the teenth week") { assert-equal((2013, 6, 16), meetup(2013, 6, Teenth, Sunday)) },
    test("when teenth Sunday is the 13th, the first day of the teenth week") { assert-equal((2013, 10, 13), meetup(2013, 10, Teenth, Sunday)) },
    test("when first Monday is some day in the middle of the first week") { assert-equal((2013, 3, 4), meetup(2013, 3, First, Monday)) },
    test("when first Monday is the 1st, the first day of the first week") { assert-equal((2013, 4, 1), meetup(2013, 4, First, Monday)) },
    test("when first Tuesday is the 7th, the last day of the first week") { assert-equal((2013, 5, 7), meetup(2013, 5, First, Tuesday)) },
    test("when first Tuesday is some day in the middle of the first week") { assert-equal((2013, 6, 4), meetup(2013, 6, First, Tuesday)) },
    test("when first Wednesday is some day in the middle of the first week") { assert-equal((2013, 7, 3), meetup(2013, 7, First, Wednesday)) },
    test("when first Wednesday is the 7th, the last day of the first week") { assert-equal((2013, 8, 7), meetup(2013, 8, First, Wednesday)) },
    test("when first Thursday is some day in the middle of the first week") { assert-equal((2013, 9, 5), meetup(2013, 9, First, Thursday)) },
    test("when first Thursday is another day in the middle of the first week") { assert-equal((2013, 10, 3), meetup(2013, 10, First, Thursday)) },
    test("when first Friday is the 1st, the first day of the first week") { assert-equal((2013, 11, 1), meetup(2013, 11, First, Friday)) },
    test("when first Friday is some day in the middle of the first week") { assert-equal((2013, 12, 6), meetup(2013, 12, First, Friday)) },
    test("when first Saturday is some day in the middle of the first week") { assert-equal((2013, 1, 5), meetup(2013, 1, First, Saturday)) },
    test("when first Saturday is another day in the middle of the first week") { assert-equal((2013, 2, 2), meetup(2013, 2, First, Saturday)) },
    test("when first Sunday is some day in the middle of the first week") { assert-equal((2013, 3, 3), meetup(2013, 3, First, Sunday)) },
    test("when first Sunday is the 7th, the last day of the first week") { assert-equal((2013, 4, 7), meetup(2013, 4, First, Sunday)) },
    test("when second Monday is some day in the middle of the second week") { assert-equal((2013, 3, 11), meetup(2013, 3, Second, Monday)) },
    test("when second Monday is the 8th, the first day of the second week") { assert-equal((2013, 4, 8), meetup(2013, 4, Second, Monday)) },
    test("when second Tuesday is the 14th, the last day of the second week") { assert-equal((2013, 5, 14), meetup(2013, 5, Second, Tuesday)) },
    test("when second Tuesday is some day in the middle of the second week") { assert-equal((2013, 6, 11), meetup(2013, 6, Second, Tuesday)) },
    test("when second Wednesday is some day in the middle of the second week") { assert-equal((2013, 7, 10), meetup(2013, 7, Second, Wednesday)) },
    test("when second Wednesday is the 14th, the last day of the second week") { assert-equal((2013, 8, 14), meetup(2013, 8, Second, Wednesday)) },
    test("when second Thursday is some day in the middle of the second week") { assert-equal((2013, 9, 12), meetup(2013, 9, Second, Thursday)) },
    test("when second Thursday is another day in the middle of the second week") { assert-equal((2013, 10, 10), meetup(2013, 10, Second, Thursday)) },
    test("when second Friday is the 8th, the first day of the second week") { assert-equal((2013, 11, 8), meetup(2013, 11, Second, Friday)) },
    test("when second Friday is some day in the middle of the second week") { assert-equal((2013, 12, 13), meetup(2013, 12, Second, Friday)) },
    test("when second Saturday is some day in the middle of the second week") { assert-equal((2013, 1, 12), meetup(2013, 1, Second, Saturday)) },
    test("when second Saturday is another day in the middle of the second week") { assert-equal((2013, 2, 9), meetup(2013, 2, Second, Saturday)) },
    test("when second Sunday is some day in the middle of the second week") { assert-equal((2013, 3, 10), meetup(2013, 3, Second, Sunday)) },
    test("when second Sunday is the 14th, the last day of the second week") { assert-equal((2013, 4, 14), meetup(2013, 4, Second, Sunday)) },
    test("when third Monday is some day in the middle of the third week") { assert-equal((2013, 3, 18), meetup(2013, 3, Third, Monday)) },
    test("when third Monday is the 15th, the first day of the third week") { assert-equal((2013, 4, 15), meetup(2013, 4, Third, Monday)) },
    test("when third Tuesday is the 21st, the last day of the third week") { assert-equal((2013, 5, 21), meetup(2013, 5, Third, Tuesday)) },
    test("when third Tuesday is some day in the middle of the third week") { assert-equal((2013, 6, 18), meetup(2013, 6, Third, Tuesday)) },
    test("when third Wednesday is some day in the middle of the third week") { assert-equal((2013, 7, 17), meetup(2013, 7, Third, Wednesday)) },
    test("when third Wednesday is the 21st, the last day of the third week") { assert-equal((2013, 8, 21), meetup(2013, 8, Third, Wednesday)) },
    test("when third Thursday is some day in the middle of the third week") { assert-equal((2013, 9, 19), meetup(2013, 9, Third, Thursday)) },
    test("when third Thursday is another day in the middle of the third week") { assert-equal((2013, 10, 17), meetup(2013, 10, Third, Thursday)) },
    test("when third Friday is the 15th, the first day of the third week") { assert-equal((2013, 11, 15), meetup(2013, 11, Third, Friday)) },
    test("when third Friday is some day in the middle of the third week") { assert-equal((2013, 12, 20), meetup(2013, 12, Third, Friday)) },
    test("when third Saturday is some day in the middle of the third week") { assert-equal((2013, 1, 19), meetup(2013, 1, Third, Saturday)) },
    test("when third Saturday is another day in the middle of the third week") { assert-equal((2013, 2, 16), meetup(2013, 2, Third, Saturday)) },
    test("when third Sunday is some day in the middle of the third week") { assert-equal((2013, 3, 17), meetup(2013, 3, Third, Sunday)) },
    test("when third Sunday is the 21st, the last day of the third week") { assert-equal((2013, 4, 21), meetup(2013, 4, Third, Sunday)) },
    test("when fourth Monday is some day in the middle of the fourth week") { assert-equal((2013, 3, 25), meetup(2013, 3, Fourth, Monday)) },
    test("when fourth Monday is the 22nd, the first day of the fourth week") { assert-equal((2013, 4, 22), meetup(2013, 4, Fourth, Monday)) },
    test("when fourth Tuesday is the 28th, the last day of the fourth week") { assert-equal((2013, 5, 28), meetup(2013, 5, Fourth, Tuesday)) },
    test("when fourth Tuesday is some day in the middle of the fourth week") { assert-equal((2013, 6, 25), meetup(2013, 6, Fourth, Tuesday)) },
    test("when fourth Wednesday is some day in the middle of the fourth week") { assert-equal((2013, 7, 24), meetup(2013, 7, Fourth, Wednesday)) },
    test("when fourth Wednesday is the 28th, the last day of the fourth week") { assert-equal((2013, 8, 28), meetup(2013, 8, Fourth, Wednesday)) },
    test("when fourth Thursday is some day in the middle of the fourth week") { assert-equal((2013, 9, 26), meetup(2013, 9, Fourth, Thursday)) },
    test("when fourth Thursday is another day in the middle of the fourth week") { assert-equal((2013, 10, 24), meetup(2013, 10, Fourth, Thursday)) },
    test("when fourth Friday is the 22nd, the first day of the fourth week") { assert-equal((2013, 11, 22), meetup(2013, 11, Fourth, Friday)) },
    test("when fourth Friday is some day in the middle of the fourth week") { assert-equal((2013, 12, 27), meetup(2013, 12, Fourth, Friday)) },
    test("when fourth Saturday is some day in the middle of the fourth week") { assert-equal((2013, 1, 26), meetup(2013, 1, Fourth, Saturday)) },
    test("when fourth Saturday is another day in the middle of the fourth week") { assert-equal((2013, 2, 23), meetup(2013, 2, Fourth, Saturday)) },
    test("when fourth Sunday is some day in the middle of the fourth week") { assert-equal((2013, 3, 24), meetup(2013, 3, Fourth, Sunday)) },
    test("when fourth Sunday is the 28th, the last day of the fourth week") { assert-equal((2013, 4, 28), meetup(2013, 4, Fourth, Sunday)) },
    test("last Monday in a month with four Mondays") { assert-equal((2013, 3, 25), meetup(2013, 3, Last, Monday)) },
    test("last Monday in a month with five Mondays") { assert-equal((2013, 4, 29), meetup(2013, 4, Last, Monday)) },
    test("last Tuesday in a month with four Tuesdays") { assert-equal((2013, 5, 28), meetup(2013, 5, Last, Tuesday)) },
    test("last Tuesday in another month with four Tuesdays") { assert-equal((2013, 6, 25), meetup(2013, 6, Last, Tuesday)) },
    test("last Wednesday in a month with five Wednesdays") { assert-equal((2013, 7, 31), meetup(2013, 7, Last, Wednesday)) },
    test("last Wednesday in a month with four Wednesdays") { assert-equal((2013, 8, 28), meetup(2013, 8, Last, Wednesday)) },
    test("last Thursday in a month with four Thursdays") { assert-equal((2013, 9, 26), meetup(2013, 9, Last, Thursday)) },
    test("last Thursday in a month with five Thursdays") { assert-equal((2013, 10, 31), meetup(2013, 10, Last, Thursday)) },
    test("last Friday in a month with five Fridays") { assert-equal((2013, 11, 29), meetup(2013, 11, Last, Friday)) },
    test("last Friday in a month with four Fridays") { assert-equal((2013, 12, 27), meetup(2013, 12, Last, Friday)) },
    test("last Saturday in a month with four Saturdays") { assert-equal((2013, 1, 26), meetup(2013, 1, Last, Saturday)) },
    test("last Saturday in another month with four Saturdays") { assert-equal((2013, 2, 23), meetup(2013, 2, Last, Saturday)) },
    test("last Sunday in a month with five Sundays") { assert-equal((2013, 3, 31), meetup(2013, 3, Last, Sunday)) },
    test("last Sunday in a month with four Sundays") { assert-equal((2013, 4, 28), meetup(2013, 4, Last, Sunday)) },
    test("when last Wednesday in February in a leap year is the 29th") { assert-equal((2012, 2, 29), meetup(2012, 2, Last, Wednesday)) },
    test("last Wednesday in December that is also the last day of the year") { assert-equal((2014, 12, 31), meetup(2014, 12, Last, Wednesday)) },
    test("when last Sunday in February in a non-leap year is not the 29th") { assert-equal((2015, 2, 22), meetup(2015, 2, Last, Sunday)) },
    test("when first Friday is the 7th, the last day of the first week") { assert-equal((2012, 12, 7), meetup(2012, 12, First, Friday)) },
  ])
