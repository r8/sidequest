import test
import clock

pub fun main()
  run([
    test("Create a new clock with an initial time > on the hour") { assert-equal("08:00", create(8, 0).to-string) },
    test("Create a new clock with an initial time > past the hour") { assert-equal("11:09", create(11, 9).to-string) },
    test("Create a new clock with an initial time > midnight is zero hours") { assert-equal("00:00", create(24, 0).to-string) },
    test("Create a new clock with an initial time > hour rolls over") { assert-equal("01:00", create(25, 0).to-string) },
    test("Create a new clock with an initial time > hour rolls over continuously") { assert-equal("04:00", create(100, 0).to-string) },
    test("Create a new clock with an initial time > sixty minutes is next hour") { assert-equal("02:00", create(1, 60).to-string) },
    test("Create a new clock with an initial time > minutes roll over") { assert-equal("02:40", create(0, 160).to-string) },
    test("Create a new clock with an initial time > minutes roll over continuously") { assert-equal("04:43", create(0, 1723).to-string) },
    test("Create a new clock with an initial time > hour and minutes roll over") { assert-equal("03:40", create(25, 160).to-string) },
    test("Create a new clock with an initial time > hour and minutes roll over continuously") { assert-equal("11:01", create(201, 3001).to-string) },
    test("Create a new clock with an initial time > hour and minutes roll over to exactly midnight") { assert-equal("00:00", create(72, 8640).to-string) },
    test("Create a new clock with an initial time > negative hour") { assert-equal("23:15", create(-1, 15).to-string) },
    test("Create a new clock with an initial time > negative hour rolls over") { assert-equal("23:00", create(-25, 0).to-string) },
    test("Create a new clock with an initial time > negative hour rolls over continuously") { assert-equal("05:00", create(-91, 0).to-string) },
    test("Create a new clock with an initial time > negative minutes") { assert-equal("00:20", create(1, -40).to-string) },
    test("Create a new clock with an initial time > negative minutes roll over") { assert-equal("22:20", create(1, -160).to-string) },
    test("Create a new clock with an initial time > negative minutes roll over continuously") { assert-equal("16:40", create(1, -4820).to-string) },
    test("Create a new clock with an initial time > negative sixty minutes is previous hour") { assert-equal("01:00", create(2, -60).to-string) },
    test("Create a new clock with an initial time > negative hour and minutes both roll over") { assert-equal("20:20", create(-25, -160).to-string) },
    test("Create a new clock with an initial time > negative hour and minutes both roll over continuously") { assert-equal("22:10", create(-121, -5810).to-string) },
    test("Add minutes > add minutes") { assert-equal("10:03", create(10, 0).add(3).to-string) },
    test("Add minutes > add no minutes") { assert-equal("06:41", create(6, 41).add(0).to-string) },
    test("Add minutes > add to next hour") { assert-equal("01:25", create(0, 45).add(40).to-string) },
    test("Add minutes > add more than one hour") { assert-equal("11:01", create(10, 0).add(61).to-string) },
    test("Add minutes > add more than two hours with carry") { assert-equal("03:25", create(0, 45).add(160).to-string) },
    test("Add minutes > add across midnight") { assert-equal("00:01", create(23, 59).add(2).to-string) },
    test("Add minutes > add more than one day (1500 min = 25 hrs)") { assert-equal("06:32", create(5, 32).add(1500).to-string) },
    test("Add minutes > add more than two days") { assert-equal("11:21", create(1, 1).add(3500).to-string) },
    test("Subtract minutes > subtract minutes") { assert-equal("10:00", create(10, 3).subtract(3).to-string) },
    test("Subtract minutes > subtract to previous hour") { assert-equal("09:33", create(10, 3).subtract(30).to-string) },
    test("Subtract minutes > subtract more than an hour") { assert-equal("08:53", create(10, 3).subtract(70).to-string) },
    test("Subtract minutes > subtract across midnight") { assert-equal("23:59", create(0, 3).subtract(4).to-string) },
    test("Subtract minutes > subtract more than two hours") { assert-equal("21:20", create(0, 0).subtract(160).to-string) },
    test("Subtract minutes > subtract more than two hours with borrow") { assert-equal("03:35", create(6, 15).subtract(160).to-string) },
    test("Subtract minutes > subtract more than one day (1500 min = 25 hrs)") { assert-equal("04:32", create(5, 32).subtract(1500).to-string) },
    test("Subtract minutes > subtract more than two days") { assert-equal("00:20", create(2, 20).subtract(3000).to-string) },
    test("Compare two clocks for equality > clocks with same time") { assert-true(create(15, 37) == create(15, 37)) },
    test("Compare two clocks for equality > clocks a minute apart") { assert-false(create(15, 36) == create(15, 37)) },
    test("Compare two clocks for equality > clocks an hour apart") { assert-false(create(14, 37) == create(15, 37)) },
    test("Compare two clocks for equality > clocks with hour overflow") { assert-true(create(10, 37) == create(34, 37)) },
    test("Compare two clocks for equality > clocks with hour overflow by several days") { assert-true(create(3, 11) == create(99, 11)) },
    test("Compare two clocks for equality > clocks with negative hour") { assert-true(create(22, 40) == create(-2, 40)) },
    test("Compare two clocks for equality > clocks with negative hour that wraps") { assert-true(create(17, 3) == create(-31, 3)) },
    test("Compare two clocks for equality > clocks with negative hour that wraps multiple times") { assert-true(create(13, 49) == create(-83, 49)) },
    test("Compare two clocks for equality > clocks with minute overflow") { assert-true(create(0, 1) == create(0, 1441)) },
    test("Compare two clocks for equality > clocks with minute overflow by several days") { assert-true(create(2, 2) == create(2, 4322)) },
    test("Compare two clocks for equality > clocks with negative minute") { assert-true(create(2, 40) == create(3, -20)) },
    test("Compare two clocks for equality > clocks with negative minute that wraps") { assert-true(create(4, 10) == create(5, -1490)) },
    test("Compare two clocks for equality > clocks with negative minute that wraps multiple times") { assert-true(create(6, 15) == create(6, -4305)) },
    test("Compare two clocks for equality > clocks with negative hours and minutes") { assert-true(create(7, 32) == create(-12, -268)) },
    test("Compare two clocks for equality > clocks with negative hours and minutes that wrap") { assert-true(create(18, 7) == create(-54, -11513)) },
    test("Compare two clocks for equality > full clock and zeroed clock") { assert-true(create(24, 0) == create(0, 0)) },
  ])
