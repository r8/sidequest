import test
import forth

pub fun main()
  run([
    test("parsing and numbers > numbers just get pushed onto the stack") { assert-equal([1, 2, 3, 4, 5], evaluate(["1 2 3 4 5"])) },
    test("parsing and numbers > pushes negative numbers onto the stack") { assert-equal([-1, -2, -3, -4, -5], evaluate(["-1 -2 -3 -4 -5"])) },
    test("addition > can add two numbers") { assert-equal([3], evaluate(["1 2 +"])) },
    test("addition > errors if there is nothing on the stack") { assert-throws("empty stack") { evaluate(["+"]) } },
    test("addition > errors if there is only one value on the stack") { assert-throws("only one value on the stack") { evaluate(["1 +"]) } },
    test("addition > more than two values on the stack") { assert-equal([1, 5], evaluate(["1 2 3 +"])) },
    test("subtraction > can subtract two numbers") { assert-equal([-1], evaluate(["3 4 -"])) },
    test("subtraction > errors if there is nothing on the stack") { assert-throws("empty stack") { evaluate(["-"]) } },
    test("subtraction > errors if there is only one value on the stack") { assert-throws("only one value on the stack") { evaluate(["1 -"]) } },
    test("subtraction > more than two values on the stack") { assert-equal([1, 9], evaluate(["1 12 3 -"])) },
    test("multiplication > can multiply two numbers") { assert-equal([8], evaluate(["2 4 *"])) },
    test("multiplication > errors if there is nothing on the stack") { assert-throws("empty stack") { evaluate(["*"]) } },
    test("multiplication > errors if there is only one value on the stack") { assert-throws("only one value on the stack") { evaluate(["1 *"]) } },
    test("multiplication > more than two values on the stack") { assert-equal([1, 6], evaluate(["1 2 3 *"])) },
    test("division > can divide two numbers") { assert-equal([4], evaluate(["12 3 /"])) },
    test("division > performs integer division") { assert-equal([2], evaluate(["8 3 /"])) },
    test("division > errors if dividing by zero") { assert-throws("divide by zero") { evaluate(["4 0 /"]) } },
    test("division > errors if there is nothing on the stack") { assert-throws("empty stack") { evaluate(["/"]) } },
    test("division > errors if there is only one value on the stack") { assert-throws("only one value on the stack") { evaluate(["1 /"]) } },
    test("division > more than two values on the stack") { assert-equal([1, 4], evaluate(["1 12 3 /"])) },
    // Not in the canonical data: floored and truncated division agree here, while Euclidean division gives 4.
    test("division > divides two negative numbers") { assert-equal([3], evaluate(["-7 -2 /"])) },
    // Not in the canonical data: integer division rounds toward zero, as in most languages' integer division.
    test("division > rounds toward zero") { assert-equal([-3], evaluate(["-7 2 /"])) },
    test("combined arithmetic > addition and subtraction") { assert-equal([-1], evaluate(["1 2 + 4 -"])) },
    test("combined arithmetic > multiplication and division") { assert-equal([2], evaluate(["2 4 * 3 /"])) },
    test("combined arithmetic > multiplication and addition") { assert-equal([13], evaluate(["1 3 4 * +"])) },
    test("combined arithmetic > addition and multiplication") { assert-equal([7], evaluate(["1 3 4 + *"])) },
    test("dup > copies a value on the stack") { assert-equal([1, 1], evaluate(["1 dup"])) },
    test("dup > copies the top value on the stack") { assert-equal([1, 2, 2], evaluate(["1 2 dup"])) },
    test("dup > errors if there is nothing on the stack") { assert-throws("empty stack") { evaluate(["dup"]) } },
    test("drop > removes the top value on the stack if it is the only one") { assert-equal([], evaluate(["1 drop"])) },
    test("drop > removes the top value on the stack if it is not the only one") { assert-equal([1], evaluate(["1 2 drop"])) },
    test("drop > errors if there is nothing on the stack") { assert-throws("empty stack") { evaluate(["drop"]) } },
    test("swap > swaps the top two values on the stack if they are the only ones") { assert-equal([2, 1], evaluate(["1 2 swap"])) },
    test("swap > swaps the top two values on the stack if they are not the only ones") { assert-equal([1, 3, 2], evaluate(["1 2 3 swap"])) },
    test("swap > errors if there is nothing on the stack") { assert-throws("empty stack") { evaluate(["swap"]) } },
    test("swap > errors if there is only one value on the stack") { assert-throws("only one value on the stack") { evaluate(["1 swap"]) } },
    test("over > copies the second element if there are only two") { assert-equal([1, 2, 1], evaluate(["1 2 over"])) },
    test("over > copies the second element if there are more than two") { assert-equal([1, 2, 3, 2], evaluate(["1 2 3 over"])) },
    test("over > errors if there is nothing on the stack") { assert-throws("empty stack") { evaluate(["over"]) } },
    test("over > errors if there is only one value on the stack") { assert-throws("only one value on the stack") { evaluate(["1 over"]) } },
    test("user-defined words > can consist of built-in words") { assert-equal([1, 1, 1], evaluate([": dup-twice dup dup ;", "1 dup-twice"])) },
    test("user-defined words > execute in the right order") { assert-equal([1, 2, 3], evaluate([": countup 1 2 3 ;", "countup"])) },
    test("user-defined words > can override other user-defined words") { assert-equal([1, 1, 1], evaluate([": foo dup ;", ": foo dup dup ;", "1 foo"])) },
    test("user-defined words > can override built-in words") { assert-equal([1, 1], evaluate([": swap dup ;", "1 swap"])) },
    test("user-defined words > can override built-in operators") { assert-equal([12], evaluate([": + * ;", "3 4 +"])) },
    test("user-defined words > can use different words with the same name") { assert-equal([5, 6], evaluate([": foo 5 ;", ": bar foo ;", ": foo 6 ;", "bar foo"])) },
    test("user-defined words > can define word that uses word with the same name") { assert-equal([11], evaluate([": foo 10 ;", ": foo foo 1 + ;", "foo"])) },
    test("user-defined words > cannot redefine non-negative numbers") { assert-throws("illegal operation") { evaluate([": 1 2 ;"]) } },
    test("user-defined words > cannot redefine negative numbers") { assert-throws("illegal operation") { evaluate([": -1 2 ;"]) } },
    test("user-defined words > errors if executing a non-existent word") { assert-throws("undefined operation") { evaluate(["foo"]) } },
    test("user-defined words > only defines locally") { assert-equal([0], evaluate([": + - ;", "1 1 +"])); assert-equal([2], evaluate(["1 1 +"])) },
    test("case-insensitivity > DUP is case-insensitive") { assert-equal([1, 1, 1, 1], evaluate(["1 DUP Dup dup"])) },
    test("case-insensitivity > DROP is case-insensitive") { assert-equal([1], evaluate(["1 2 3 4 DROP Drop drop"])) },
    test("case-insensitivity > SWAP is case-insensitive") { assert-equal([2, 3, 4, 1], evaluate(["1 2 SWAP 3 Swap 4 swap"])) },
    test("case-insensitivity > OVER is case-insensitive") { assert-equal([1, 2, 1, 2, 1], evaluate(["1 2 OVER Over over"])) },
    test("case-insensitivity > user-defined words are case-insensitive") { assert-equal([1, 1, 1, 1], evaluate([": foo dup ;", "1 FOO Foo foo"])) },
    test("case-insensitivity > definitions are case-insensitive") { assert-equal([1, 1, 1, 1], evaluate([": SWAP DUP Dup dup ;", "1 swap"])) },
    // Not in the canonical data: a line with no words is a valid (empty) program.
    test("empty and blank lines do nothing") { assert-equal([1, 2], evaluate(["1", "", "   ", "2"])) },
    // Not in the canonical data: words are separated by any whitespace, however much.
    test("words are separated by any whitespace") { assert-equal([3], evaluate(["1  2\t+"])) },
  ])
