import std.sync (Channel)

# Returns how many kilograms of fish a boat brings back from `ground`.
fn pub catch_at(ground: String) -> Int {
  match ground {
    case 'north' -> 120
    case 'reef' -> 45
    case 'bank' -> 80
    case _ -> 10
  }
}

