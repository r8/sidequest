import market_stall (apply_rule, combine, count_where, discount, price_tag)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('1. apply a rule that adds', fn (t) {
    t.equal(apply_rule([100, 250], fn (price) { price + 50 }), [150, 300])
  })
  t.test('1. apply a rule that halves', fn (t) {
    t.equal(apply_rule([100, 250, 30], fn (price) { price / 2 }), [50, 125, 15])
  })
  t.test('1. apply a rule to no prices', fn (t) {
    t.equal(apply_rule([], fn (price) { price * 2 }), [])
  })
  t.test('1. the original list is unchanged', fn (t) {
    let prices = [100, 200]
    let _ = apply_rule(prices, fn (price) { price + 1 })

    t.equal(prices, [100, 200])
  })

  t.test('2. count expensive prices', fn (t) {
    t.equal(count_where([100, 250, 400], fn (price) { price > 200 }), 2)
  })
  t.test('2. count round prices', fn (t) {
    t.equal(
      count_where([100, 250, 400, 99], fn (price) { price % 100 == 0 }),
      2,
    )
  })
  t.test('2. count nothing', fn (t) {
    t.equal(count_where([100], fn (price) { price < 0 }), 0)
  })

  t.test('3. ten percent off', fn (t) { t.equal(discount(10).call(250), 225) })
  t.test('3. half price', fn (t) { t.equal(discount(50).call(250), 125) })
  t.test('3. fractions of a cent are dropped from the discount', fn (t) {
    t.equal(discount(10).call(99), 90)
  })
  t.test('3. no discount', fn (t) { t.equal(discount(0).call(250), 250) })

  t.test('4. a price tag in euros', fn (t) {
    t.equal(price_tag('€').call(205), '€2.05')
  })
  t.test('4. a price tag in pounds', fn (t) {
    t.equal(price_tag('£').call(1250), '£12.50')
  })
  t.test('4. a price tag under one unit', fn (t) {
    t.equal(price_tag('$').call(7), '$0.07')
  })

  t.test('5. combine a discount and a reduction', fn (t) {
    t.equal(combine(discount(50), fn (price) { price - 10 }).call(200), 90)
  })
  t.test('5. combine in the other order', fn (t) {
    t.equal(combine(fn (price) { price - 10 }, discount(50)).call(200), 95)
  })
  t.test('5. combine with every price', fn (t) {
    t.equal(
      apply_rule([100, 300], combine(discount(10), discount(10))),
      [81, 243],
    )
  })
}
