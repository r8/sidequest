# A tool, which goes blunt after three jobs.
type pub Tool {
  let @name: String
  let mut @jobs: Int

  # Returns a new, sharp tool called `name`.
  fn pub static new(name: String) -> Tool {
    Tool(name: name, jobs: 0)
  }

  # Returns the name of the tool.
  fn pub name -> String {
    @name
  }

  # Returns how many jobs the tool has done since it was last sharpened.
  fn pub jobs -> Int {
    @jobs
  }

  # Returns whether the tool needs sharpening.
  fn pub blunt? -> Bool {
    @jobs >= 3
  }

  # Records that the tool was used for a job.
  fn pub mut work {
    @jobs += 1
  }

  # Sharpens the tool.
  fn pub mut sharpen {
    @jobs = 0
  }
}

