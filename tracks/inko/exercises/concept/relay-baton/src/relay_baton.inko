# The baton a team passes from runner to runner.
type pub Baton {
  let @team: String
  let mut @handoffs: Int

  # Returns a new baton for `team`, not passed on yet.
  fn pub static new(team: String) -> Baton {
    Baton(team: team, handoffs: 0)
  }

  # Returns the team the baton belongs to.
  fn pub team -> String {
    @team
  }

  # Returns how many times the baton has been passed on.
  fn pub handoffs -> Int {
    @handoffs
  }

  # Records that the baton was passed on.
  fn pub mut passed {
    @handoffs += 1
  }
}

