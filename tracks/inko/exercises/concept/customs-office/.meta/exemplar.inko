# Returns `kilograms` if the weight is allowed (1 to 30), or an error.
fn pub check_weight(kilograms: Int) -> Result[Int, String] {
  if kilograms < 1 {
    Result.Error('too light')
  } else if kilograms > 30 {
    Result.Error('too heavy')
  } else {
    Result.Ok(kilograms)
  }
}

# Returns the number written in `text`, or an error.
fn pub read_number(text: String) -> Result[Int, String] {
  Int.parse(text, 10).ok_or('not a number: ${text}')
}

# Returns the allowed weight written in `text`, or an error.
fn pub read_weight(text: String) -> Result[Int, String] {
  read_number(text).then(fn (kilograms) { check_weight(kilograms) })
}

# Returns the value with 20% duty added, passing an error on.
fn pub with_duty(value: Result[Int, String]) -> Result[Int, String] {
  value.map(fn (cents) { cents + (cents / 5) })
}

# Returns `result` with the name of the form in front of its error.
fn pub on_form(result: Result[Int, String], form: String) -> Result[Int, String]
{
  result.map_error(fn (error) { '${form}: ${error}' })
}

# Returns "cleared: N" or "held: REASON".
fn pub stamp(result: Result[Int, String]) -> String {
  match result {
    case Ok(value) -> 'cleared: ${value}'
    case Error(reason) -> 'held: ${reason}'
  }
}
