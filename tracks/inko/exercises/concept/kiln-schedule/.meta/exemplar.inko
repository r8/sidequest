let FIRING_MINUTES = 480
let GLAZING_MINUTES_PER_PIECE = 12

# Returns how many minutes a firing takes.
fn pub firing_minutes -> Int {
  FIRING_MINUTES
}

# Returns how many minutes of the firing are left after `elapsed` minutes.
fn pub remaining_minutes(elapsed: Int) -> Int {
  FIRING_MINUTES - elapsed
}

# Returns how many minutes it takes to glaze `pieces` pieces.
fn pub glazing_minutes(pieces: Int) -> Int {
  pieces * GLAZING_MINUTES_PER_PIECE
}

# Returns the minutes spent glazing `pieces` pieces plus the `elapsed` minutes
# of firing.
fn pub total_minutes(pieces: Int, elapsed: Int) -> Int {
  glazing_minutes(pieces) + elapsed
}
