import std.drop (Drop)

# A paper lantern. When a lantern is dropped, it goes out, and says so in the
# festival log.
type pub Lantern {
  let @name: String
  let @log: mut Array[String]

  # Returns a lit lantern called `name`, which writes to `log`.
  fn pub static new(name: String, log: mut Array[String]) -> Lantern {
    Lantern(name: name, log: log)
  }

  # Returns the name of the lantern.
  fn pub name -> String {
    @name
  }
}

impl Drop for Lantern {
  fn mut drop {
    panic('implement me')
  }
}

