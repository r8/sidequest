# Returns the sign for `owner`'s shop, such as "Rosa's Bakery".
fn pub shop_sign(owner: String, trade: String) -> String {
  "${owner}'s ${trade}"
}

# Returns `order` without whitespace at its start and end.
fn pub tidy(order: String) -> String {
  order.trim
}

# Returns `text` tidied and in capitals, between three stars on either side.
fn pub banner(text: String) -> String {
  '*** ${tidy(text).to_upper} ***'
}

# Returns the number of characters in `text` that aren't spaces.
fn pub painted_characters(text: String) -> Int {
  text.replace(' ', '').chars.count
}

# Returns `number` as four digits, padded with leading zeros.
fn pub door_plate(number: Int) -> String {
  number.to_string.pad_start(with: '0', chars: 4)
}
