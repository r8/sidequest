# Returns whether the lamp is lit at `hour` (0 to 23).
fn pub lamp_on?(hour: Int) -> Bool {
  hour >= 20 or hour < 6
}

# Returns whether to sound the foghorn.
fn pub foghorn?(visibility: Int, ships_nearby: Bool) -> Bool {
  visibility < 1000 and ships_nearby
}

# Returns the storm flag for a wind speed of `knots`.
fn pub storm_flag(knots: Int) -> String {
  if knots < 34 {
    'none'
  } else if knots < 48 {
    'gale'
  } else if knots < 64 {
    'storm'
  } else {
    'hurricane'
  }
}

# Returns whether the keeper can rest.
fn pub can_rest?(
  hour: Int,
  visibility: Int,
  ships_nearby: Bool,
  knots: Int,
) -> Bool {
  !lamp_on?(hour) and !foghorn?(visibility, ships_nearby) and knots < 34
}
