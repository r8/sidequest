# A painting and the artist who painted it.
type pub Painting {
  let @name: String
  let @artist: String
  let @year: Int

  fn pub static new(name: String, artist: String, year: Int) -> Painting {
    Painting(name: name, artist: artist, year: year)
  }
}

impl Exhibit for Painting {
  fn pub title -> String {
    panic('implement me')
  }

  fn pub year -> Int {
    panic('implement me')
  }
}

impl ToString for Painting {
  # Returns the painting's title.
  fn pub to_string -> String {
    panic('implement me')
  }
}

# A musical instrument, which visitors may be allowed to play.
type pub Instrument {
  let @kind: String
  let @maker: String
  let @year: Int
  let @playable: Bool

  fn pub static new(
    kind: String,
    maker: String,
    year: Int,
    playable: Bool,
  ) -> Instrument {
    Instrument(kind: kind, maker: maker, year: year, playable: playable)
  }
}

impl Exhibit for Instrument {
  fn pub title -> String {
    panic('implement me')
  }

  fn pub year -> Int {
    panic('implement me')
  }

  fn pub plaque -> String {
    panic('implement me')
  }
}

