import std.cmp (Equal)
import std.fmt (Format, Formatter)

# A scoring category.
type pub copy enum Category {
  case Ones
  case Twos
  case Threes
  case Fours
  case Fives
  case Sixes
  case FullHouse
  case FourOfAKind
  case LittleStraight
  case BigStraight
  case Choice
  case Yacht
}

impl Equal for Category {
  fn pub ==(other: Category) -> Bool {
    match (self, other) {
      case (Ones, Ones) -> true
      case (Twos, Twos) -> true
      case (Threes, Threes) -> true
      case (Fours, Fours) -> true
      case (Fives, Fives) -> true
      case (Sixes, Sixes) -> true
      case (FullHouse, FullHouse) -> true
      case (FourOfAKind, FourOfAKind) -> true
      case (LittleStraight, LittleStraight) -> true
      case (BigStraight, BigStraight) -> true
      case (Choice, Choice) -> true
      case (Yacht, Yacht) -> true
      case _ -> false
    }
  }
}

impl Format for Category {
  fn pub fmt(formatter: mut Formatter) {
    let name = match self {
      case Ones -> 'Ones'
      case Twos -> 'Twos'
      case Threes -> 'Threes'
      case Fours -> 'Fours'
      case Fives -> 'Fives'
      case Sixes -> 'Sixes'
      case FullHouse -> 'FullHouse'
      case FourOfAKind -> 'FourOfAKind'
      case LittleStraight -> 'LittleStraight'
      case BigStraight -> 'BigStraight'
      case Choice -> 'Choice'
      case Yacht -> 'Yacht'
    }

    formatter.tuple(name).finish
  }
}

# Returns how many of `dice` show `face`.
fn count(dice: ref Array[Int], face: Int) -> Int {
  dice.iter.select(fn (die) { die == face }).count
}

# Returns the sum of `dice` times `face`.
fn faces(dice: ref Array[Int], face: Int) -> Int {
  count(dice, face) * face
}

# Returns the score of the five `dice` (each 1 to 6) in `category`.
fn pub score(dice: Array[Int], category: Category) -> Int {
  let total = Int.sum(dice.iter)
  let counts = 1.to(6).iter.map(fn (face) { count(dice, face) }).to_array

  dice.sort

  match category {
    case Ones -> faces(dice, 1)
    case Twos -> faces(dice, 2)
    case Threes -> faces(dice, 3)
    case Fours -> faces(dice, 4)
    case Fives -> faces(dice, 5)
    case Sixes -> faces(dice, 6)
    case FullHouse -> {
      if counts.contains?(3) and counts.contains?(2) { total } else { 0 }
    }
    case FourOfAKind -> {
      match counts.iter.with_index.find(fn (pair) { pair.1 >= 4 }) {
        case Some((index, _)) -> (index + 1) * 4
        case _ -> 0
      }
    }
    case LittleStraight -> if dice == [1, 2, 3, 4, 5] { 30 } else { 0 }
    case BigStraight -> if dice == [2, 3, 4, 5, 6] { 30 } else { 0 }
    case Choice -> total
    case Yacht -> if counts.contains?(5) { 50 } else { 0 }
  }
}
