import affine_cipher (decode, encode)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('encode > encode yes', fn (t) { t.equal(encode('yes', a: 5, b: 7), Result.Ok('xbt')) })
  t.test('encode > encode no', fn (t) { t.equal(encode('no', a: 15, b: 18), Result.Ok('fu')) })
  t.test('encode > encode OMG', fn (t) { t.equal(encode('OMG', a: 21, b: 3), Result.Ok('lvz')) })
  t.test('encode > encode O M G', fn (t) { t.equal(encode('O M G', a: 25, b: 47), Result.Ok('hjp')) })
  t.test('encode > encode mindblowingly', fn (t) { t.equal(encode('mindblowingly', a: 11, b: 15), Result.Ok('rzcwa gnxzc dgt')) })
  t.test('encode > encode numbers', fn (t) { t.equal(encode('Testing,1 2 3, testing.', a: 3, b: 4), Result.Ok('jqgjc rw123 jqgjc rw')) })
  t.test('encode > encode deep thought', fn (t) { t.equal(encode('Truth is fiction.', a: 5, b: 17), Result.Ok('iynia fdqfb ifje')) })
  t.test('encode > encode all the letters', fn (t) {
    t.equal(encode('The quick brown fox jumps over the lazy dog.', a: 17, b: 33), Result.Ok('swxtj npvyk lruol iejdc blaxk swxmh qzglf'))
  })
  t.test('encode > encode with a not coprime to m', fn (t) { t.equal(encode('This is a test.', a: 6, b: 17), Result.Error('a and m must be coprime.')) })
  t.test('decode > decode exercism', fn (t) { t.equal(decode('tytgn fjr', a: 3, b: 7), Result.Ok('exercism')) })
  t.test('decode > decode a sentence', fn (t) {
    t.equal(decode('qdwju nqcro muwhn odqun oppmd aunwd o', a: 19, b: 16), Result.Ok('anobstacleisoftenasteppingstone'))
  })
  t.test('decode > decode numbers', fn (t) { t.equal(decode('odpoz ub123 odpoz ub', a: 25, b: 7), Result.Ok('testing123testing')) })
  t.test('decode > decode all the letters', fn (t) {
    t.equal(decode('swxtj npvyk lruol iejdc blaxk swxmh qzglf', a: 17, b: 33), Result.Ok('thequickbrownfoxjumpsoverthelazydog'))
  })
  t.test('decode > decode with no spaces in input', fn (t) {
    t.equal(decode('swxtjnpvyklruoliejdcblaxkswxmhqzglf', a: 17, b: 33), Result.Ok('thequickbrownfoxjumpsoverthelazydog'))
  })
  t.test('decode > decode with too many spaces', fn (t) { t.equal(decode('vszzm    cly   yd cg    qdp', a: 15, b: 16), Result.Ok('jollygreengiant')) })
  t.test('decode > decode with a not coprime to m', fn (t) { t.equal(decode('Test', a: 13, b: 5), Result.Error('a and m must be coprime.')) })
}
