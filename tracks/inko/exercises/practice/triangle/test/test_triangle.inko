import std.test (Tests)
import triangle (equilateral?, isosceles?, scalene?)

fn pub tests(t: mut Tests) {
  t.test('equilateral triangle > all sides are equal', fn (t) { t.true(equilateral?(2.0, 2.0, 2.0)) })
  t.test('equilateral triangle > any side is unequal', fn (t) { t.false(equilateral?(2.0, 3.0, 2.0)) })
  t.test('equilateral triangle > no sides are equal', fn (t) { t.false(equilateral?(5.0, 4.0, 6.0)) })
  t.test('equilateral triangle > all zero sides is not a triangle', fn (t) { t.false(equilateral?(0.0, 0.0, 0.0)) })
  t.test('equilateral triangle > sides may be floats', fn (t) { t.true(equilateral?(0.5, 0.5, 0.5)) })
  t.test('isosceles triangle > last two sides are equal', fn (t) { t.true(isosceles?(3.0, 4.0, 4.0)) })
  t.test('isosceles triangle > first two sides are equal', fn (t) { t.true(isosceles?(4.0, 4.0, 3.0)) })
  t.test('isosceles triangle > first and last sides are equal', fn (t) { t.true(isosceles?(4.0, 3.0, 4.0)) })
  t.test('isosceles triangle > equilateral triangles are also isosceles', fn (t) { t.true(isosceles?(4.0, 4.0, 4.0)) })
  t.test('isosceles triangle > no sides are equal', fn (t) { t.false(isosceles?(2.0, 3.0, 4.0)) })
  t.test('isosceles triangle > first triangle inequality violation', fn (t) { t.false(isosceles?(1.0, 1.0, 3.0)) })
  t.test('isosceles triangle > second triangle inequality violation', fn (t) { t.false(isosceles?(1.0, 3.0, 1.0)) })
  t.test('isosceles triangle > third triangle inequality violation', fn (t) { t.false(isosceles?(3.0, 1.0, 1.0)) })
  t.test('isosceles triangle > sides may be floats', fn (t) { t.true(isosceles?(0.5, 0.4, 0.5)) })
  t.test('scalene triangle > no sides are equal', fn (t) { t.true(scalene?(5.0, 4.0, 6.0)) })
  t.test('scalene triangle > all sides are equal', fn (t) { t.false(scalene?(4.0, 4.0, 4.0)) })
  t.test('scalene triangle > first and second sides are equal', fn (t) { t.false(scalene?(4.0, 4.0, 3.0)) })
  t.test('scalene triangle > first and third sides are equal', fn (t) { t.false(scalene?(3.0, 4.0, 3.0)) })
  t.test('scalene triangle > second and third sides are equal', fn (t) { t.false(scalene?(4.0, 3.0, 3.0)) })
  t.test('scalene triangle > may not violate triangle inequality', fn (t) { t.false(scalene?(7.0, 3.0, 2.0)) })
  t.test('scalene triangle > sides may be floats', fn (t) { t.true(scalene?(0.5, 0.4, 0.6)) })
}
