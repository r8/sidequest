# Returns the square of the sum of the first `number` natural numbers.
fn pub square_of_sum(number: Int) -> Int {
  Int.sum(1.to(number).iter) ** 2
}

# Returns the sum of the squares of the first `number` natural numbers.
fn pub sum_of_squares(number: Int) -> Int {
  Int.sum(1.to(number).iter.map(fn (n) { n * n }))
}

# Returns the difference between the square of the sum and the sum of the
# squares of the first `number` natural numbers.
fn pub difference_of_squares(number: Int) -> Int {
  square_of_sum(number) - sum_of_squares(number)
}
