import std.cmp (Equal)
import std.fmt (Format, Formatter)
import std.map (Map)

# An undirected graph with attributes on its nodes, its edges and itself.
#
# Attribute values are kept as strings, without the quotes they may have in
# the input: `[foo=1]`, `[bar=true]` and `[title="Testing Attrs"]` give the
# values "1", "true" and "Testing Attrs".
#
# The `with_*` methods build a graph step by step (the tests use them to build
# the graphs they expect); you can use them in `parse` too.
type pub Graph {
  # The attributes of each node, by node name.
  let pub @nodes: Map[String, Map[String, String]]

  # The attributes of each edge, by the names of the two nodes it connects,
  # in alphabetical order.
  let pub @edges: Map[(String, String), Map[String, String]]

  # The attributes of the graph itself.
  let pub @attrs: Map[String, String]

  # Returns an empty graph.
  fn pub static new -> Graph {
    Graph(nodes: Map.new, edges: Map.new, attrs: Map.new)
  }

  # Returns the graph with the node `name`, which has the given `attrs`.
  fn pub move with_node(name: String, attrs: Array[(String, String)]) -> Graph {
    @nodes.set(name, to_map(attrs))
    self
  }

  # Returns the graph with an edge between the nodes `a` and `b`, which has the
  # given `attrs`. The nodes themselves aren't added.
  fn pub move with_edge(a: String, b: String, attrs: Array[(String, String)]) -> Graph {
    @edges.set(edge_key(a, b), to_map(attrs))
    self
  }

  # Returns the graph with the attribute `name` set to `value`.
  fn pub move with_attr(name: String, value: String) -> Graph {
    @attrs.set(name, value)
    self
  }
}

impl Equal for Graph {
  fn pub ==(other: ref Graph) -> Bool {
    @nodes == other.nodes and @edges == other.edges and @attrs == other.attrs
  }
}

impl Format for Graph {
  fn pub fmt(formatter: mut Formatter) {
    formatter
      .object('Graph')
      .field('nodes', @nodes)
      .field('edges', @edges)
      .field('attrs', @attrs)
      .finish
  }
}

# Returns the key of the edge between the nodes `a` and `b` in `Graph.edges`.
fn pub edge_key(a: String, b: String) -> (String, String) {
  if a <= b { (a, b) } else { (b, a) }
}

fn to_map(pairs: Array[(String, String)]) -> Map[String, String] {
  let map = Map.new

  for (name, value) in pairs.into_iter { map.set(name, value) }

  map
}

# Parses the `lines` of a graph in a subset of the DOT language, or returns
# one of the errors "invalid graph", "invalid edge", "invalid attribute" or
# "node name must be alphanumeric".
#
# The first line is `graph {` and the last is `}`. Each line between them is
# empty, a comment (starting with `//` or `#`), or a statement ending in `;`:
#
# - `a;` or `a [name=value, …];`: a node with optional attributes;
# - `a -- b;`, `a -- b -- c [name=value];`, …: edges (with optional
#   attributes applied to each), adding their nodes;
# - `[name=value, …];`: attributes of the graph.
#
# Repeated statements about the same node or edge (in either direction) merge
# their attributes.
fn pub parse(lines: Array[String]) -> Result[Graph, String] {
  let lines = lines.into_iter.map(fn (line) { line.trim }).to_array

  if lines.size < 2
    or lines.first.or('') != 'graph {'
    or lines.last.or('') != '}'
  {
    return Result.Error('invalid graph')
  }

  let graph = Graph.new

  for line in lines.slice(1, lines.size - 1).iter {
    if line.empty? or line.starts_with?('//') or line.starts_with?('#') {
      next
    }

    try statement(graph, line.strip_suffix(';').or(line))
  }

  Result.Ok(graph)
}

# Adds the statement `text` (without its `;`) to `graph`.
fn statement(graph: mut Graph, text: String) -> Result[Nil, String] {
  let (head, attrs) = match text.split_once('[') {
    case Some((head, rest)) -> {
      match rest.strip_suffix(']') {
        case Some(list) -> (head.trim.to_string, try attributes(list.to_string))
        case None -> throw 'invalid attribute'
      }
    }
    case None -> (text.trim, [])
  }

  if head.empty? {
    for (name, value) in attrs.into_iter { graph.attrs.set(name, value) }

    return Result.Ok(nil)
  }

  let words = head
    .split(' ')
    .select(fn (word) { !word.empty? })
    .map(fn (word) { word.to_string })
    .to_array

  if words.size == 1 {
    let name = words.pop.get

    if !alphanumeric?(name) { throw 'node name must be alphanumeric' }

    merge(node(graph, name), attrs)
    return Result.Ok(nil)
  }

  if words.size % 2 == 0 { throw 'invalid edge' }

  let names = []

  for (index, word) in words.into_iter.with_index {
    if index % 2 == 1 {
      if word != '--' { throw 'invalid edge' }
    } else if alphanumeric?(word) {
      names.push(word)
    } else {
      throw 'node name must be alphanumeric'
    }
  }

  for name in names.iter { let _ = node(graph, name) }

  for index in 1.until(names.size) {
    let key = edge_key(names.get(index - 1).or_panic, names.get(index).or_panic)

    match graph.edges.get_mut(key) {
      case Ok(edge) -> merge(edge, attrs.clone)
      case Error(_) -> { let _ = graph.edges.set(key, to_map(attrs.clone)) }
    }
  }

  Result.Ok(nil)
}

# Parses the comma-separated `name=value` pairs of an attribute list.
fn attributes(list: String) -> Result[Array[(String, String)], String] {
  let pairs = []

  for pair in list.split(',') {
    match pair.split_once('=') {
      case Some((name, value)) if name.trim.size > 0 -> {
        pairs.push((name.trim.to_string, unquoted(value.trim.to_string)))
      }
      case _ -> throw 'invalid attribute'
    }
  }

  Result.Ok(pairs)
}

# Returns the attributes of the node `name`, adding the node if needed.
fn node(graph: mut Graph, name: String) -> mut Map[String, String] {
  if !graph.nodes.contains?(name) { graph.nodes.set(name, Map.new) }

  graph.nodes.get_mut(name).or_panic
}

fn merge(map: mut Map[String, String], pairs: Array[(String, String)]) {
  for (name, value) in pairs.into_iter { map.set(name, value) }
}

fn unquoted(value: String) -> String {
  value.strip_prefix('"').then(fn (rest) { rest.strip_suffix('"') }).or(value)
}

fn alphanumeric?(name: String) -> Bool {
  name.bytes.all?(fn (byte) {
    (byte >= 48 and byte <= 57)
      or (byte >= 65 and byte <= 90)
      or (byte >= 97 and byte <= 122)
  })
}
