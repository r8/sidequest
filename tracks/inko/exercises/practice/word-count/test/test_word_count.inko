import std.map (Map)
import std.test (Tests)
import word_count (count_words)

fn counts(pairs: Array[(String, Int)]) -> Map[String, Int] {
  let map = Map.new

  for (word, count) in pairs.into_iter { map.set(word, count) }

  map
}

fn pub tests(t: mut Tests) {
  t.test('count one word', fn (t) { t.equal(count_words('word'), counts([('word', 1)])) })
  t.test('count one of each word', fn (t) {
    t.equal(count_words('one of each'), counts([('one', 1), ('of', 1), ('each', 1)]))
  })
  t.test('multiple occurrences of a word', fn (t) {
    t.equal(
      count_words('one fish two fish red fish blue fish'),
      counts([('one', 1), ('fish', 4), ('two', 1), ('red', 1), ('blue', 1)]),
    )
  })
  t.test('handles cramped lists', fn (t) {
    t.equal(count_words('one,two,three'), counts([('one', 1), ('two', 1), ('three', 1)]))
  })
  t.test('handles expanded lists', fn (t) {
    t.equal(count_words('one,\ntwo,\nthree'), counts([('one', 1), ('two', 1), ('three', 1)]))
  })
  t.test('ignore punctuation', fn (t) {
    t.equal(
      count_words('car: carpet as java: javascript!!&@$%^&'),
      counts([('car', 1), ('carpet', 1), ('as', 1), ('java', 1), ('javascript', 1)]),
    )
  })
  t.test('include numbers', fn (t) {
    t.equal(count_words('testing, 1, 2 testing'), counts([('1', 1), ('2', 1), ('testing', 2)]))
  })
  t.test('normalize case', fn (t) {
    t.equal(count_words('go Go GO Stop stop'), counts([('go', 3), ('stop', 2)]))
  })
  t.test('with apostrophes', fn (t) {
    t.equal(
      count_words("'First: don't laugh. Then: don't cry. You're getting it.'"),
      counts(
        [
          ('first', 1),
          ("don't", 2),
          ('laugh', 1),
          ('then', 1),
          ('cry', 1),
          ("you're", 1),
          ('getting', 1),
          ('it', 1),
        ],
      ),
    )
  })
  t.test('with quotations', fn (t) {
    t.equal(
      count_words("Joe can't tell between 'large' and large."),
      counts([('joe', 1), ("can't", 1), ('tell', 1), ('between', 1), ('large', 2), ('and', 1)]),
    )
  })
  t.test('substrings from the beginning', fn (t) {
    t.equal(
      count_words("Joe can't tell between app, apple and a."),
      counts(
        [
          ('joe', 1),
          ("can't", 1),
          ('tell', 1),
          ('between', 1),
          ('app', 1),
          ('apple', 1),
          ('and', 1),
          ('a', 1),
        ],
      ),
    )
  })
  t.test('multiple spaces not detected as a word', fn (t) {
    t.equal(count_words(' multiple   whitespaces'), counts([('multiple', 1), ('whitespaces', 1)]))
  })
  t.test('alternating word separators not detected as a word', fn (t) {
    t.equal(count_words(",\n,one,\n ,two \n 'three'"), counts([('one', 1), ('two', 1), ('three', 1)]))
  })
  t.test('quotation for word with apostrophe', fn (t) {
    t.equal(count_words("can, can't, 'can't'"), counts([('can', 1), ("can't", 2)]))
  })
}
