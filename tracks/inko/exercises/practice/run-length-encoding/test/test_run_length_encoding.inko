import run_length_encoding (decode, encode)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('run-length encode a string > empty string', fn (t) { t.equal(encode(''), '') })
  t.test('run-length encode a string > single characters only are encoded without count', fn (t) { t.equal(encode('XYZ'), 'XYZ') })
  t.test('run-length encode a string > string with no single characters', fn (t) { t.equal(encode('AABBBCCCC'), '2A3B4C') })
  t.test('run-length encode a string > single characters mixed with repeated characters', fn (t) {
    t.equal(encode('WWWWWWWWWWWWBWWWWWWWWWWWWBBBWWWWWWWWWWWWWWWWWWWWWWWWB'), '12WB12W3B24WB')
  })
  t.test('run-length encode a string > multiple whitespace mixed in string', fn (t) { t.equal(encode('  hsqq qww  '), '2 hs2q q2w2 ') })
  t.test('run-length encode a string > lowercase characters', fn (t) { t.equal(encode('aabbbcccc'), '2a3b4c') })
  t.test('run-length decode a string > empty string', fn (t) { t.equal(decode(''), '') })
  t.test('run-length decode a string > single characters only', fn (t) { t.equal(decode('XYZ'), 'XYZ') })
  t.test('run-length decode a string > string with no single characters', fn (t) { t.equal(decode('2A3B4C'), 'AABBBCCCC') })
  t.test('run-length decode a string > single characters with repeated characters', fn (t) {
    t.equal(decode('12WB12W3B24WB'), 'WWWWWWWWWWWWBWWWWWWWWWWWWBBBWWWWWWWWWWWWWWWWWWWWWWWWB')
  })
  t.test('run-length decode a string > multiple whitespace mixed in string', fn (t) { t.equal(decode('2 hs2q q2w2 '), '  hsqq qww  ') })
  t.test('run-length decode a string > lowercase string', fn (t) { t.equal(decode('2a3b4c'), 'aabbbcccc') })
  t.test('encode and then decode > encode followed by decode gives original string', fn (t) { t.equal(decode(encode('zzz ZZ  zZ')), 'zzz ZZ  zZ') })
}
