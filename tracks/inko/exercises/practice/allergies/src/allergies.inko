# allergens. Bits above 128 are ignored.
fn pub allergic_to?(item: Allergen, score: Int) -> Bool {
  panic('implement me')
}

# Returns the allergens included in the allergy `score`, from the lowest score
# to the highest.
fn pub list(score: Int) -> Array[Allergen] {
  panic('implement me')
