import std.cmp (Equal)
import std.fmt (Format, Formatter)

# A substance a person can be allergic to.
type pub copy enum Allergen {
  case Eggs
  case Peanuts
  case Shellfish
  case Strawberries
  case Tomatoes
  case Chocolate
  case Pollen
  case Cats
}

impl Equal for Allergen {
  fn pub ==(other: Allergen) -> Bool {
    match (self, other) {
      case (Eggs, Eggs) -> true
      case (Peanuts, Peanuts) -> true
      case (Shellfish, Shellfish) -> true
      case (Strawberries, Strawberries) -> true
      case (Tomatoes, Tomatoes) -> true
      case (Chocolate, Chocolate) -> true
      case (Pollen, Pollen) -> true
      case (Cats, Cats) -> true
      case _ -> false
    }
  }
}

impl Format for Allergen {
  fn pub fmt(formatter: mut Formatter) {
    let name = match self {
      case Eggs -> 'Eggs'
      case Peanuts -> 'Peanuts'
      case Shellfish -> 'Shellfish'
      case Strawberries -> 'Strawberries'
      case Tomatoes -> 'Tomatoes'
      case Chocolate -> 'Chocolate'
      case Pollen -> 'Pollen'
      case Cats -> 'Cats'
    }

    formatter.write(name)
  }
}

