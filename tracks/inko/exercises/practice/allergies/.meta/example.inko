import std.cmp (Equal)
import std.fmt (Format, Formatter)

# A substance a person can be allergic to.
type pub copy enum Allergen {
  case Eggs
  case Peanuts
  case Shellfish
  case Strawberries
  case Tomatoes
  case Chocolate
  case Pollen
  case Cats
}

impl Equal for Allergen {
  fn pub ==(other: Allergen) -> Bool {
    match (self, other) {
      case (Eggs, Eggs) -> true
      case (Peanuts, Peanuts) -> true
      case (Shellfish, Shellfish) -> true
      case (Strawberries, Strawberries) -> true
      case (Tomatoes, Tomatoes) -> true
      case (Chocolate, Chocolate) -> true
      case (Pollen, Pollen) -> true
      case (Cats, Cats) -> true
      case _ -> false
    }
  }
}

impl Format for Allergen {
  fn pub fmt(formatter: mut Formatter) {
    let name = match self {
      case Eggs -> 'Eggs'
      case Peanuts -> 'Peanuts'
      case Shellfish -> 'Shellfish'
      case Strawberries -> 'Strawberries'
      case Tomatoes -> 'Tomatoes'
      case Chocolate -> 'Chocolate'
      case Pollen -> 'Pollen'
      case Cats -> 'Cats'
    }

    formatter.write(name)
  }
}

# Returns `true` if the allergy `score` includes `item`. Each allergen has a
# score (eggs 1, peanuts 2, shellfish 4, strawberries 8, tomatoes 16, chocolate
# 32, pollen 64, cats 128); the allergy score is the sum of the scores of the
# allergens. Bits above 128 are ignored.
fn pub allergic_to?(item: Allergen, score: Int) -> Bool {
  score & value(item) != 0
}

# Returns the allergens included in the allergy `score`, from the lowest score
# to the highest.
fn pub list(score: Int) -> Array[Allergen] {
  all.into_iter.select(fn (item) { allergic_to?(item, score) }).to_array
}

fn all -> Array[Allergen] {
  [
    Allergen.Eggs,
    Allergen.Peanuts,
    Allergen.Shellfish,
    Allergen.Strawberries,
    Allergen.Tomatoes,
    Allergen.Chocolate,
    Allergen.Pollen,
    Allergen.Cats,
  ]
}

fn value(item: Allergen) -> Int {
  match item {
    case Eggs -> 1
    case Peanuts -> 2
    case Shellfish -> 4
    case Strawberries -> 8
    case Tomatoes -> 16
    case Chocolate -> 32
    case Pollen -> 64
    case Cats -> 128
  }
}
