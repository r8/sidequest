import std.cmp (Equal, min)
import std.deque (Deque)
import std.fmt (Format, Formatter)
import std.set (Set)

# One of the two buckets.
type pub copy enum Bucket {
  case One
  case Two
}

impl Equal for Bucket {
  fn pub ==(other: Bucket) -> Bool {
    match (self, other) {
      case (One, One) -> true
      case (Two, Two) -> true
      case _ -> false
    }
  }
}

impl Format for Bucket {
  fn pub fmt(formatter: mut Formatter) {
    let name = match self {
      case One -> 'One'
      case Two -> 'Two'
    }

    formatter.tuple(name).finish
  }
}

# The outcome of measuring: the number of moves (the first fill included),
# the bucket that ends up holding the goal amount, and the amount left in the
# other bucket.
type pub BucketStats {
  let pub @moves: Int
  let pub @goal_bucket: Bucket
  let pub @other_bucket: Int
}

impl Equal for BucketStats {
  fn pub ==(other: ref BucketStats) -> Bool {
    @moves == other.moves
      and @goal_bucket == other.goal_bucket
      and @other_bucket == other.other_bucket
  }
}

impl Format for BucketStats {
  fn pub fmt(formatter: mut Formatter) {
    formatter
      .object('BucketStats')
      .field('moves', @moves)
      .field('goal_bucket', @goal_bucket)
      .field('other_bucket', @other_bucket)
      .finish
  }
}

# Measures `goal` liters with buckets of `bucket_one` and `bucket_two` liters,
# starting by filling `start_bucket`. Each fill, empty or pour is one move, and
# the state with the starting bucket empty and the other one full is never
# allowed. Returns the error "impossible" if the goal can't be reached.
fn pub measure(
  bucket_one: Int,
  bucket_two: Int,
  goal: Int,
  start_bucket: Bucket,
) -> Result[BucketStats, String] {
  # The search works on (start bucket, other bucket) amounts, so the forbidden
  # state is always (0, other size).
  let (start_size, other_size) = match start_bucket {
    case One -> (bucket_one, bucket_two)
    case Two -> (bucket_two, bucket_one)
  }
  let other_bucket = match start_bucket {
    case One -> Bucket.Two
    case Two -> Bucket.One
  }
  let seen = Set.new
  let queue = Deque.new

  queue.push_back((start_size, 0, 1))

  loop {
    let (start, other, moves) = match queue.pop_front {
      case Some(state) -> state
      case None -> return Result.Error('impossible')
    }

    if start == goal {
      return Result.Ok(
        BucketStats(
          moves: moves,
          goal_bucket: start_bucket,
          other_bucket: other,
        ),
      )
    }

    if other == goal {
      return Result.Ok(
        BucketStats(
          moves: moves,
          goal_bucket: other_bucket,
          other_bucket: start,
        ),
      )
    }

    if !seen.insert((start, other)) { next }

    let to_other = min(start, other_size - other)
    let to_start = min(other, start_size - start)
    let states = [
      (start_size, other),
      (start, other_size),
      (0, other),
      (start, 0),
      (start - to_other, other + to_other),
      (start + to_start, other - to_start),
    ]

    for (a, b) in states.into_iter {
      if !(a == 0 and b == other_size) { queue.push_back((a, b, moves + 1)) }
    }
  }
}
