import isogram (isogram?)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('empty string', fn (t) { t.true(isogram?('')) })
  t.test('isogram with only lower case characters', fn (t) { t.true(isogram?('isogram')) })
  t.test('word with one duplicated character', fn (t) { t.false(isogram?('eleven')) })
  t.test('word with one duplicated character from the end of the alphabet', fn (t) {
    t.false(isogram?('zzyzx'))
  })
  t.test('longest reported english isogram', fn (t) { t.true(isogram?('subdermatoglyphic')) })
  t.test('word with duplicated character in mixed case', fn (t) { t.false(isogram?('Alphabet')) })
  t.test('word with duplicated character in mixed case, lowercase first', fn (t) {
    t.false(isogram?('alphAbet'))
  })
  t.test('hypothetical isogrammic word with hyphen', fn (t) { t.true(isogram?('thumbscrew-japingly')) })
  t.test('hypothetical word with duplicated character following hyphen', fn (t) {
    t.false(isogram?('thumbscrew-jappingly'))
  })
  t.test('isogram with duplicated hyphen', fn (t) { t.true(isogram?('six-year-old')) })
  t.test('made-up name that is an isogram', fn (t) { t.true(isogram?('Emily Jung Schwartzkopf')) })
  t.test('duplicated character in the middle', fn (t) { t.false(isogram?('accentor')) })
  t.test('same first and last characters', fn (t) { t.false(isogram?('angola')) })
  t.test('word with duplicated character and with two hyphens', fn (t) { t.false(isogram?('up-to-date')) })
}
