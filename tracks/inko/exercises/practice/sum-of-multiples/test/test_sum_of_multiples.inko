import std.test (Tests)
import sum_of_multiples (sum)

fn pub tests(t: mut Tests) {
  t.test('no multiples within limit', fn (t) { t.equal(sum([3, 5], 1), 0) })
  t.test('one factor has multiples within limit', fn (t) { t.equal(sum([3, 5], 4), 3) })
  t.test('more than one multiple within limit', fn (t) { t.equal(sum([3], 7), 9) })
  t.test('more than one factor with multiples within limit', fn (t) { t.equal(sum([3, 5], 10), 23) })
  t.test('each multiple is only counted once', fn (t) { t.equal(sum([3, 5], 100), 2318) })
  t.test('a much larger limit', fn (t) { t.equal(sum([3, 5], 1000), 233168) })
  t.test('three factors', fn (t) { t.equal(sum([7, 13, 17], 20), 51) })
  t.test('factors not relatively prime', fn (t) { t.equal(sum([4, 6], 15), 30) })
  t.test('some pairs of factors relatively prime and some not', fn (t) { t.equal(sum([5, 6, 8], 150), 4419) })
  t.test('one factor is a multiple of another', fn (t) { t.equal(sum([5, 25], 51), 275) })
  t.test('much larger factors', fn (t) { t.equal(sum([43, 47], 10000), 2203160) })
  t.test('all numbers are multiples of 1', fn (t) { t.equal(sum([1], 100), 4950) })
  t.test('no factors means an empty sum', fn (t) { t.equal(sum([], 10000), 0) })
  t.test('the only multiple of 0 is 0', fn (t) { t.equal(sum([0], 1), 0) })
  t.test('the factor 0 does not affect the sum of multiples of other factors', fn (t) { t.equal(sum([3, 0], 4), 3) })
  t.test('solutions using include-exclude must extend to cardinality greater than 3', fn (t) { t.equal(sum([2, 3, 5, 7, 11], 10000), 39614537) })
}
