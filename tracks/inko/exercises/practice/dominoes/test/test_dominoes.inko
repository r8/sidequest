import dominoes (can_chain?)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('empty input = empty output', fn (t) { t.true(can_chain?([])) })
  t.test('singleton input = singleton output', fn (t) { t.true(can_chain?([(1, 1)])) })
  t.test("singleton that can't be chained", fn (t) { t.false(can_chain?([(1, 2)])) })
  t.test('three elements', fn (t) { t.true(can_chain?([(1, 2), (3, 1), (2, 3)])) })
  t.test('can reverse dominoes', fn (t) { t.true(can_chain?([(1, 2), (1, 3), (2, 3)])) })
  t.test("can't be chained", fn (t) { t.false(can_chain?([(1, 2), (4, 1), (2, 3)])) })
  t.test('disconnected - simple', fn (t) { t.false(can_chain?([(1, 1), (2, 2)])) })
  t.test('disconnected - double loop', fn (t) { t.false(can_chain?([(1, 2), (2, 1), (3, 4), (4, 3)])) })
  t.test('disconnected - single isolated', fn (t) { t.false(can_chain?([(1, 2), (2, 3), (3, 1), (4, 4)])) })
  t.test('need backtrack', fn (t) { t.true(can_chain?([(1, 2), (2, 3), (3, 1), (2, 4), (2, 4)])) })
  t.test('separate loops', fn (t) { t.true(can_chain?([(1, 2), (2, 3), (3, 1), (1, 1), (2, 2), (3, 3)])) })
  t.test('nine elements', fn (t) {
    t.true(can_chain?([(1, 2), (5, 3), (3, 1), (1, 2), (2, 4), (1, 6), (2, 3), (3, 4), (5, 6)]))
  })
  t.test('separate three-domino loops', fn (t) {
    t.false(can_chain?([(1, 2), (2, 3), (3, 1), (4, 5), (5, 6), (6, 4)]))
  })
}
