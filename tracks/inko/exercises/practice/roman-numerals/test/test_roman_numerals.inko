import roman_numerals (roman)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('1 is I', fn (t) { t.equal(roman(1), 'I') })
  t.test('2 is II', fn (t) { t.equal(roman(2), 'II') })
  t.test('3 is III', fn (t) { t.equal(roman(3), 'III') })
  t.test('4 is IV', fn (t) { t.equal(roman(4), 'IV') })
  t.test('5 is V', fn (t) { t.equal(roman(5), 'V') })
  t.test('6 is VI', fn (t) { t.equal(roman(6), 'VI') })
  t.test('9 is IX', fn (t) { t.equal(roman(9), 'IX') })
  t.test('16 is XVI', fn (t) { t.equal(roman(16), 'XVI') })
  t.test('27 is XXVII', fn (t) { t.equal(roman(27), 'XXVII') })
  t.test('48 is XLVIII', fn (t) { t.equal(roman(48), 'XLVIII') })
  t.test('49 is XLIX', fn (t) { t.equal(roman(49), 'XLIX') })
  t.test('59 is LIX', fn (t) { t.equal(roman(59), 'LIX') })
  t.test('66 is LXVI', fn (t) { t.equal(roman(66), 'LXVI') })
  t.test('93 is XCIII', fn (t) { t.equal(roman(93), 'XCIII') })
  t.test('141 is CXLI', fn (t) { t.equal(roman(141), 'CXLI') })
  t.test('163 is CLXIII', fn (t) { t.equal(roman(163), 'CLXIII') })
  t.test('166 is CLXVI', fn (t) { t.equal(roman(166), 'CLXVI') })
  t.test('402 is CDII', fn (t) { t.equal(roman(402), 'CDII') })
  t.test('575 is DLXXV', fn (t) { t.equal(roman(575), 'DLXXV') })
  t.test('666 is DCLXVI', fn (t) { t.equal(roman(666), 'DCLXVI') })
  t.test('911 is CMXI', fn (t) { t.equal(roman(911), 'CMXI') })
  t.test('1024 is MXXIV', fn (t) { t.equal(roman(1024), 'MXXIV') })
  t.test('1666 is MDCLXVI', fn (t) { t.equal(roman(1666), 'MDCLXVI') })
  t.test('3000 is MMM', fn (t) { t.equal(roman(3000), 'MMM') })
  t.test('3001 is MMMI', fn (t) { t.equal(roman(3001), 'MMMI') })
  t.test('3888 is MMMDCCCLXXXVIII', fn (t) { t.equal(roman(3888), 'MMMDCCCLXXXVIII') })
  t.test('3999 is MMMCMXCIX', fn (t) { t.equal(roman(3999), 'MMMCMXCIX') })
}
