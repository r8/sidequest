import custom_set (CustomSet)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('Returns true if the set contains no elements > sets with no elements are empty', fn (t) {
    let set: CustomSet[Int] = CustomSet.new([])

    t.true(set.empty?)
  })
  t.test('Returns true if the set contains no elements > sets with elements are not empty', fn (t) {
    let set = CustomSet.new([1])

    t.false(set.empty?)
  })
  t.test('Sets can report if they contain an element > nothing is contained in an empty set', fn (t) {
    let set: CustomSet[Int] = CustomSet.new([])

    t.false(set.contains?(1))
  })
  t.test('Sets can report if they contain an element > when the element is in the set', fn (t) {
    let set = CustomSet.new([1, 2, 3])

    t.true(set.contains?(1))
  })
  t.test('Sets can report if they contain an element > when the element is not in the set', fn (t) {
    let set = CustomSet.new([1, 2, 3])

    t.false(set.contains?(4))
  })
  t.test('A set is a subset if all of its elements are contained in the other set > empty set is a subset of another empty set', fn (t) {
    let set1: CustomSet[Int] = CustomSet.new([])
    let set2: CustomSet[Int] = CustomSet.new([])

    t.true(set1.subset?(set2))
  })
  t.test('A set is a subset if all of its elements are contained in the other set > empty set is a subset of non-empty set', fn (t) {
    let set1: CustomSet[Int] = CustomSet.new([])
    let set2 = CustomSet.new([1])

    t.true(set1.subset?(set2))
  })
  t.test('A set is a subset if all of its elements are contained in the other set > non-empty set is not a subset of empty set', fn (t) {
    let set1 = CustomSet.new([1])
    let set2: CustomSet[Int] = CustomSet.new([])

    t.false(set1.subset?(set2))
  })
  t.test('A set is a subset if all of its elements are contained in the other set > set is a subset of set with exact same elements', fn (t) {
    let set1 = CustomSet.new([1, 2, 3])
    let set2 = CustomSet.new([1, 2, 3])

    t.true(set1.subset?(set2))
  })
  t.test('A set is a subset if all of its elements are contained in the other set > set is a subset of larger set with same elements', fn (t) {
    let set1 = CustomSet.new([1, 2, 3])
    let set2 = CustomSet.new([4, 1, 2, 3])

    t.true(set1.subset?(set2))
  })
  t.test('A set is a subset if all of its elements are contained in the other set > set is not a subset of set that does not contain its elements', fn (t) {
    let set1 = CustomSet.new([1, 2, 3])
    let set2 = CustomSet.new([4, 1, 3])

    t.false(set1.subset?(set2))
  })
  t.test('Sets are disjoint if they share no elements > the empty set is disjoint with itself', fn (t) {
    let set1: CustomSet[Int] = CustomSet.new([])
    let set2: CustomSet[Int] = CustomSet.new([])

    t.true(set1.disjoint?(set2))
  })
  t.test('Sets are disjoint if they share no elements > empty set is disjoint with non-empty set', fn (t) {
    let set1: CustomSet[Int] = CustomSet.new([])
    let set2 = CustomSet.new([1])

    t.true(set1.disjoint?(set2))
  })
  t.test('Sets are disjoint if they share no elements > non-empty set is disjoint with empty set', fn (t) {
    let set1 = CustomSet.new([1])
    let set2: CustomSet[Int] = CustomSet.new([])

    t.true(set1.disjoint?(set2))
  })
  t.test('Sets are disjoint if they share no elements > sets are not disjoint if they share an element', fn (t) {
    let set1 = CustomSet.new([1, 2])
    let set2 = CustomSet.new([2, 3])

    t.false(set1.disjoint?(set2))
  })
  t.test('Sets are disjoint if they share no elements > sets are disjoint if they share no elements', fn (t) {
    let set1 = CustomSet.new([1, 2])
    let set2 = CustomSet.new([3, 4])

    t.true(set1.disjoint?(set2))
  })
  t.test('Sets with the same elements are equal > empty sets are equal', fn (t) {
    let set1: CustomSet[Int] = CustomSet.new([])
    let set2: CustomSet[Int] = CustomSet.new([])

    t.true(set1 == set2)
  })
  t.test('Sets with the same elements are equal > empty set is not equal to non-empty set', fn (t) {
    let set1: CustomSet[Int] = CustomSet.new([])
    let set2 = CustomSet.new([1, 2, 3])

    t.false(set1 == set2)
  })
  t.test('Sets with the same elements are equal > non-empty set is not equal to empty set', fn (t) {
    let set1 = CustomSet.new([1, 2, 3])
    let set2: CustomSet[Int] = CustomSet.new([])

    t.false(set1 == set2)
  })
  t.test('Sets with the same elements are equal > sets with the same elements are equal', fn (t) {
    let set1 = CustomSet.new([1, 2])
    let set2 = CustomSet.new([2, 1])

    t.true(set1 == set2)
  })
  t.test('Sets with the same elements are equal > sets with different elements are not equal', fn (t) {
    let set1 = CustomSet.new([1, 2, 3])
    let set2 = CustomSet.new([1, 2, 4])

    t.false(set1 == set2)
  })
  t.test('Sets with the same elements are equal > set is not equal to larger set with same elements', fn (t) {
    let set1 = CustomSet.new([1, 2, 3])
    let set2 = CustomSet.new([1, 2, 3, 4])

    t.false(set1 == set2)
  })
  t.test('Sets with the same elements are equal > set is equal to a set constructed from an array with duplicates', fn (t) {
    let set1 = CustomSet.new([1])
    let set2 = CustomSet.new([1, 1])

    t.true(set1 == set2)
  })
  t.test('Unique elements can be added to a set > add to empty set', fn (t) {
    let set: CustomSet[Int] = CustomSet.new([])

    set.add(3)
    t.equal(set, CustomSet.new([3]))
  })
  t.test('Unique elements can be added to a set > add to non-empty set', fn (t) {
    let set = CustomSet.new([1, 2, 4])

    set.add(3)
    t.equal(set, CustomSet.new([1, 2, 3, 4]))
  })
  t.test('Unique elements can be added to a set > adding an existing element does not change the set', fn (t) {
    let set = CustomSet.new([1, 2, 3])

    set.add(3)
    t.equal(set, CustomSet.new([1, 2, 3]))
  })
  t.test('Intersection returns a set of all shared elements > intersection of two empty sets is an empty set', fn (t) {
    let set1: CustomSet[Int] = CustomSet.new([])
    let set2: CustomSet[Int] = CustomSet.new([])

    t.equal(set1.intersection(set2), CustomSet.new([]))
  })
  t.test('Intersection returns a set of all shared elements > intersection of an empty set and non-empty set is an empty set', fn (t) {
    let set1: CustomSet[Int] = CustomSet.new([])
    let set2 = CustomSet.new([3, 2, 5])

    t.equal(set1.intersection(set2), CustomSet.new([]))
  })
  t.test('Intersection returns a set of all shared elements > intersection of a non-empty set and an empty set is an empty set', fn (t) {
    let set1 = CustomSet.new([1, 2, 3, 4])
    let set2: CustomSet[Int] = CustomSet.new([])

    t.equal(set1.intersection(set2), CustomSet.new([]))
  })
  t.test('Intersection returns a set of all shared elements > intersection of two sets with no shared elements is an empty set', fn (t) {
    let set1 = CustomSet.new([1, 2, 3])
    let set2 = CustomSet.new([4, 5, 6])

    t.equal(set1.intersection(set2), CustomSet.new([]))
  })
  t.test('Intersection returns a set of all shared elements > intersection of two sets with shared elements is a set of the shared elements', fn (t) {
    let set1 = CustomSet.new([1, 2, 3, 4])
    let set2 = CustomSet.new([3, 2, 5])

    t.equal(set1.intersection(set2), CustomSet.new([2, 3]))
  })
  t.test('Difference (or Complement) of a set is a set of all elements that are only in the first set > difference of two empty sets is an empty set', fn (t) {
    let set1: CustomSet[Int] = CustomSet.new([])
    let set2: CustomSet[Int] = CustomSet.new([])

    t.equal(set1.difference(set2), CustomSet.new([]))
  })
  t.test('Difference (or Complement) of a set is a set of all elements that are only in the first set > difference of empty set and non-empty set is an empty set', fn (t) {
    let set1: CustomSet[Int] = CustomSet.new([])
    let set2 = CustomSet.new([3, 2, 5])

    t.equal(set1.difference(set2), CustomSet.new([]))
  })
  t.test('Difference (or Complement) of a set is a set of all elements that are only in the first set > difference of a non-empty set and an empty set is the non-empty set', fn (t) {
    let set1 = CustomSet.new([1, 2, 3, 4])
    let set2: CustomSet[Int] = CustomSet.new([])

    t.equal(set1.difference(set2), CustomSet.new([1, 2, 3, 4]))
  })
  t.test('Difference (or Complement) of a set is a set of all elements that are only in the first set > difference of two non-empty sets is a set of elements that are only in the first set', fn (t) {
    let set1 = CustomSet.new([3, 2, 1])
    let set2 = CustomSet.new([2, 4])

    t.equal(set1.difference(set2), CustomSet.new([1, 3]))
  })
  t.test('Difference (or Complement) of a set is a set of all elements that are only in the first set > difference removes all duplicates in the first set', fn (t) {
    let set1 = CustomSet.new([1, 1])
    let set2 = CustomSet.new([1])

    t.equal(set1.difference(set2), CustomSet.new([]))
  })
  t.test('Union returns a set of all elements in either set > union of empty sets is an empty set', fn (t) {
    let set1: CustomSet[Int] = CustomSet.new([])
    let set2: CustomSet[Int] = CustomSet.new([])

    t.equal(set1.union(set2), CustomSet.new([]))
  })
  t.test('Union returns a set of all elements in either set > union of an empty set and non-empty set is the non-empty set', fn (t) {
    let set1: CustomSet[Int] = CustomSet.new([])
    let set2 = CustomSet.new([2])

    t.equal(set1.union(set2), CustomSet.new([2]))
  })
  t.test('Union returns a set of all elements in either set > union of a non-empty set and empty set is the non-empty set', fn (t) {
    let set1 = CustomSet.new([1, 3])
    let set2: CustomSet[Int] = CustomSet.new([])

    t.equal(set1.union(set2), CustomSet.new([1, 3]))
  })
  t.test('Union returns a set of all elements in either set > union of non-empty sets contains all unique elements', fn (t) {
    let set1 = CustomSet.new([1, 3])
    let set2 = CustomSet.new([2, 3])

    t.equal(set1.union(set2), CustomSet.new([3, 2, 1]))
  })
}
