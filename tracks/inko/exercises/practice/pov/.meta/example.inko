import std.cmp (Equal)
import std.fmt (Format, Formatter)

# A tree of labelled nodes. The order of `children` carries no meaning.
type pub Tree {
  let pub @label: String
  let pub @children: Array[Tree]

  # Returns a tree with the given `label` and `children`.
  fn pub static new(label: String, children: Array[Tree]) -> Tree {
    Tree(label: label, children: children)
  }

  # Returns a tree with the given `label` and no children.
  fn pub static leaf(label: String) -> Tree {
    Tree(label: label, children: [])
  }
}

impl Equal for Tree {
  # Returns `true` if both trees have the same labels with their children in
  # the same order.
  fn pub ==(other: ref Tree) -> Bool {
    @label == other.label and @children == other.children
  }
}

impl Format for Tree {
  fn pub fmt(formatter: mut Formatter) {
    formatter.write('Tree(')
    @label.fmt(formatter)

    if @children.size > 0 {
      formatter.write(', ')
      @children.fmt(formatter)
    }

    formatter.write(')')
  }
}

# Returns `tree` reoriented so the node labelled `from` is its root, or `None`
# if there is no such node. `tree` is consumed: the result is built from its
# nodes.
fn pub from_pov(tree: Tree, from: String) -> Option[Tree] {
  if !contains?(tree, from) { return Option.None }

  Option.Some(reroot(tree, from))
}

# Returns the labels on the path from the node labelled `from` to the node
# labelled `to`, both included, or `None` if either node doesn't exist.
fn pub path_to(tree: Tree, from: String, to: String) -> Option[Array[String]] {
  from_pov(tree, from).then(fn (root) { path(root, to) })
}

fn contains?(tree: ref Tree, label: String) -> Bool {
  tree.label == label or tree.children.iter.any?(fn (child) { contains?(child, label) })
}

# Moves the root of `tree` one level down at a time, below the child that leads
# to `from`, until `from` is the root. `from` must be in `tree`.
fn reroot(tree: Tree, from: String) -> Tree {
  if tree.label == from { return tree }

  match tree {
    case { @label = label, @children = children } -> {
      let index = children
        .iter
        .with_index
        .find(fn (pair) { contains?(pair.1, from) })
        .map(fn (pair) { pair.0 })
        .get
      let child = children.remove_at(index).or_panic

      match child {
        case { @label = child_label, @children = grandchildren } -> {
          grandchildren.push(Tree.new(label, children))
          reroot(Tree.new(child_label, grandchildren), from)
        }
      }
    }
  }
}

# Returns the labels from the root of `tree` down to the node labelled `to`.
fn path(tree: ref Tree, to: String) -> Option[Array[String]] {
  if tree.label == to { return Option.Some([tree.label]) }

  tree.children.iter.find_map(fn (child) {
    path(child, to).map(fn (rest) {
      rest.insert(0, tree.label)
      rest
    })
  })
}
