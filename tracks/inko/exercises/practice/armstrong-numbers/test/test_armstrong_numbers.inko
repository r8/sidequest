import armstrong_numbers (armstrong_number?)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('Zero is an Armstrong number', fn (t) { t.true(armstrong_number?(0)) })
  t.test('Single-digit numbers are Armstrong numbers', fn (t) { t.true(armstrong_number?(5)) })
  t.test('There are no two-digit Armstrong numbers', fn (t) { t.false(armstrong_number?(10)) })
  t.test('Three-digit number that is an Armstrong number', fn (t) { t.true(armstrong_number?(153)) })
  t.test('Three-digit number that is not an Armstrong number', fn (t) { t.false(armstrong_number?(100)) })
  t.test('Four-digit number that is an Armstrong number', fn (t) { t.true(armstrong_number?(9474)) })
  t.test('Four-digit number that is not an Armstrong number', fn (t) { t.false(armstrong_number?(9475)) })
  t.test('Seven-digit number that is an Armstrong number', fn (t) { t.true(armstrong_number?(9926315)) })
  t.test('Seven-digit number that is not an Armstrong number', fn (t) { t.false(armstrong_number?(9926314)) })
  # Not in the canonical data: the sum of a 19-digit number's powers can exceed
  # the largest Int, which must not overflow.
  t.test('Nineteen-digit number whose sum of powers overflows an Int', fn (t) { t.false(armstrong_number?(7999999999999999999)) })
}
