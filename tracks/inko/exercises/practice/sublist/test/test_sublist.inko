import sublist (Comparison, sublist)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('empty lists', fn (t) {
    let one: Array[Int] = []
    let two: Array[Int] = []

    t.equal(sublist(one, two), Comparison.Equal)
  })
  t.test('empty list within non empty list', fn (t) {
    let one: Array[Int] = []
    let two: Array[Int] = [1, 2, 3]

    t.equal(sublist(one, two), Comparison.Sublist)
  })
  t.test('non empty list contains empty list', fn (t) {
    let one: Array[Int] = [1, 2, 3]
    let two: Array[Int] = []

    t.equal(sublist(one, two), Comparison.Superlist)
  })
  t.test('list equals itself', fn (t) { t.equal(sublist([1, 2, 3], [1, 2, 3]), Comparison.Equal) })
  t.test('different lists', fn (t) { t.equal(sublist([1, 2, 3], [2, 3, 4]), Comparison.Unequal) })
  t.test('false start', fn (t) { t.equal(sublist([1, 2, 5], [0, 1, 2, 3, 1, 2, 5, 6]), Comparison.Sublist) })
  t.test('consecutive', fn (t) { t.equal(sublist([1, 1, 2], [0, 1, 1, 1, 2, 1, 2]), Comparison.Sublist) })
  t.test('sublist at start', fn (t) { t.equal(sublist([0, 1, 2], [0, 1, 2, 3, 4, 5]), Comparison.Sublist) })
  t.test('sublist in middle', fn (t) { t.equal(sublist([2, 3, 4], [0, 1, 2, 3, 4, 5]), Comparison.Sublist) })
  t.test('sublist at end', fn (t) { t.equal(sublist([3, 4, 5], [0, 1, 2, 3, 4, 5]), Comparison.Sublist) })
  t.test('at start of superlist', fn (t) { t.equal(sublist([0, 1, 2, 3, 4, 5], [0, 1, 2]), Comparison.Superlist) })
  t.test('in middle of superlist', fn (t) { t.equal(sublist([0, 1, 2, 3, 4, 5], [2, 3]), Comparison.Superlist) })
  t.test('at end of superlist', fn (t) { t.equal(sublist([0, 1, 2, 3, 4, 5], [3, 4, 5]), Comparison.Superlist) })
  t.test('first list missing element from second list', fn (t) { t.equal(sublist([1, 3], [1, 2, 3]), Comparison.Unequal) })
  t.test('second list missing element from first list', fn (t) { t.equal(sublist([1, 2, 3], [1, 3]), Comparison.Unequal) })
  t.test('first list missing additional digits from second list', fn (t) { t.equal(sublist([1, 2], [1, 22]), Comparison.Unequal) })
  t.test('order matters to a list', fn (t) { t.equal(sublist([1, 2, 3], [3, 2, 1]), Comparison.Unequal) })
  t.test('same digits but different numbers', fn (t) { t.equal(sublist([1, 0, 1], [10, 1]), Comparison.Unequal) })
}
