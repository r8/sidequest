import largest_series_product (largest_product)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('finds the largest product if span equals length', fn (t) { t.equal(largest_product('29', 2), Result.Ok(18)) })
  t.test('can find the largest product of 2 with numbers in order', fn (t) { t.equal(largest_product('0123456789', 2), Result.Ok(72)) })
  t.test('can find the largest product of 2', fn (t) { t.equal(largest_product('576802143', 2), Result.Ok(48)) })
  t.test('can find the largest product of 3 with numbers in order', fn (t) { t.equal(largest_product('0123456789', 3), Result.Ok(504)) })
  t.test('can find the largest product of 3', fn (t) { t.equal(largest_product('1027839564', 3), Result.Ok(270)) })
  t.test('can find the largest product of 5 with numbers in order', fn (t) { t.equal(largest_product('0123456789', 5), Result.Ok(15120)) })
  t.test('can get the largest product of a big number', fn (t) {
    t.equal(largest_product('73167176531330624919225119674426574742355349194934', 6), Result.Ok(23520))
  })
  t.test('reports zero if the only digits are zero', fn (t) { t.equal(largest_product('0000', 2), Result.Ok(0)) })
  t.test('reports zero if all spans include zero', fn (t) { t.equal(largest_product('99099', 3), Result.Ok(0)) })
  t.test('rejects span longer than string length', fn (t) {
    t.equal(largest_product('123', 4), Result.Error('span must not exceed string length'))
  })
  t.test('reports 1 for empty string and empty product (0 span)', fn (t) { t.equal(largest_product('', 0), Result.Ok(1)) })
  t.test('reports 1 for nonempty string and empty product (0 span)', fn (t) { t.equal(largest_product('123', 0), Result.Ok(1)) })
  t.test('rejects empty string and nonzero span', fn (t) {
    t.equal(largest_product('', 1), Result.Error('span must not exceed string length'))
  })
  t.test('rejects invalid character in digits', fn (t) {
    t.equal(largest_product('1234a5', 2), Result.Error('digits input must only contain digits'))
  })
  t.test('rejects negative span', fn (t) { t.equal(largest_product('12345', -1), Result.Error('span must not be negative')) })
}
