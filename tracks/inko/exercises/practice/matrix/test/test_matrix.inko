import matrix (Matrix)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('extract row from one number matrix', fn (t) {
    t.equal(Matrix.new('1').row(1), Option.Some([1]))
  })
  t.test('can extract row', fn (t) {
    t.equal(Matrix.new('1 2\n3 4').row(2), Option.Some([3, 4]))
  })
  t.test('extract row where numbers have different widths', fn (t) {
    t.equal(Matrix.new('1 2\n10 20').row(2), Option.Some([10, 20]))
  })
  t.test(
    'can extract row from non-square matrix with no corresponding column',
    fn (t) {
      t.equal(
        Matrix.new('1 2 3\n4 5 6\n7 8 9\n8 7 6').row(4),
        Option.Some([8, 7, 6]),
      )
    },
  )
  t.test('extract column from one number matrix', fn (t) {
    t.equal(Matrix.new('1').column(1), Option.Some([1]))
  })
  t.test('can extract column', fn (t) {
    t.equal(Matrix.new('1 2 3\n4 5 6\n7 8 9').column(3), Option.Some([3, 6, 9]))
  })
  t.test(
    'can extract column from non-square matrix with no corresponding row',
    fn (t) {
      t.equal(
        Matrix.new('1 2 3 4\n5 6 7 8\n9 8 7 6').column(4),
        Option.Some([4, 8, 6]),
      )
    },
  )
  t.test('extract column where numbers have different widths', fn (t) {
    t.equal(
      Matrix.new('89 1903 3\n18 3 1\n9 4 800').column(2),
      Option.Some([1903, 3, 4]),
    )
  })
}
