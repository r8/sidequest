import atbash_cipher (decode, encode)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('encode > encode yes', fn (t) { t.equal(encode('yes'), 'bvh') })
  t.test('encode > encode no', fn (t) { t.equal(encode('no'), 'ml') })
  t.test('encode > encode OMG', fn (t) { t.equal(encode('OMG'), 'lnt') })
  t.test('encode > encode spaces', fn (t) { t.equal(encode('O M G'), 'lnt') })
  t.test('encode > encode mindblowingly', fn (t) { t.equal(encode('mindblowingly'), 'nrmwy oldrm tob') })
  t.test('encode > encode numbers', fn (t) { t.equal(encode('Testing,1 2 3, testing.'), 'gvhgr mt123 gvhgr mt') })
  t.test('encode > encode deep thought', fn (t) { t.equal(encode('Truth is fiction.'), 'gifgs rhurx grlm') })
  t.test('encode > encode all the letters', fn (t) {
    t.equal(encode('The quick brown fox jumps over the lazy dog.'), 'gsvjf rxpyi ldmul cqfnk hlevi gsvoz abwlt')
  })
  t.test('decode > decode exercism', fn (t) { t.equal(decode('vcvix rhn'), 'exercism') })
  t.test('decode > decode a sentence', fn (t) { t.equal(decode('zmlyh gzxov rhlug vmzhg vkkrm thglm v'), 'anobstacleisoftenasteppingstone') })
  t.test('decode > decode numbers', fn (t) { t.equal(decode('gvhgr mt123 gvhgr mt'), 'testing123testing') })
  t.test('decode > decode all the letters', fn (t) {
    t.equal(decode('gsvjf rxpyi ldmul cqfnk hlevi gsvoz abwlt'), 'thequickbrownfoxjumpsoverthelazydog')
  })
  t.test('decode > decode with too many spaces', fn (t) { t.equal(decode('vc vix    r hn'), 'exercism') })
  t.test('decode > decode with no spaces', fn (t) { t.equal(decode('zmlyhgzxovrhlugvmzhgvkkrmthglmv'), 'anobstacleisoftenasteppingstone') })
}
