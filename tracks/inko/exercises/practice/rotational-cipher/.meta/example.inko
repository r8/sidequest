fn shift(byte: Int, base: Int, key: Int) -> Int {
  (byte - base + key) % 26 + base
}

# Rotates every letter of `text` by `shift_key` places in the alphabet,
# keeping its case; other characters are left as they are.
fn pub rotate(text: String, shift_key: Int) -> String {
  let out = ByteArray.new

  for byte in text.bytes {
    out.push(
      if byte >= 65 and byte <= 90 {
        shift(byte, base: 65, key: shift_key)
      } else if byte >= 97 and byte <= 122 {
        shift(byte, base: 97, key: shift_key)
      } else {
        byte
      },
    )
  }

  out.into_string
}
