import list_ops (append, concat, filter, foldl, foldr, length, map, reverse)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('append entries to a list and return the new list > empty lists', fn (t) {
    let list1: Array[Int] = []
    let list2: Array[Int] = []

    t.equal(append(list1, list2), [])
  })
  t.test('append entries to a list and return the new list > list to empty list', fn (t) {
    let list1: Array[Int] = []
    let list2: Array[Int] = [1, 2, 3, 4]

    t.equal(append(list1, list2), [1, 2, 3, 4])
  })
  t.test('append entries to a list and return the new list > empty list to list', fn (t) {
    let list1: Array[Int] = [1, 2, 3, 4]
    let list2: Array[Int] = []

    t.equal(append(list1, list2), [1, 2, 3, 4])
  })
  t.test('append entries to a list and return the new list > non-empty lists', fn (t) {
    let list1: Array[Int] = [1, 2]
    let list2: Array[Int] = [2, 3, 4, 5]

    t.equal(append(list1, list2), [1, 2, 2, 3, 4, 5])
  })
  t.test('concatenate a list of lists > empty list', fn (t) {
    let lists: Array[Array[Int]] = []

    t.equal(concat(lists), [])
  })
  t.test('concatenate a list of lists > list of lists', fn (t) {
    let lists: Array[Array[Int]] = [[1, 2], [3], [], [4, 5, 6]]

    t.equal(concat(lists), [1, 2, 3, 4, 5, 6])
  })
  t.test('concatenate a list of lists > list of nested lists', fn (t) {
    let lists: Array[Array[Array[Int]]] = [[[1], [2]], [[3]], [[]], [[4, 5, 6]]]

    t.equal(concat(lists), [[1], [2], [3], [], [4, 5, 6]])
  })
  t.test('filter list returning only values that satisfy the filter function > empty list', fn (t) {
    let list: Array[Int] = []

    t.equal(filter(list, fn (x) { x % 2 == 1 }), [])
  })
  t.test('filter list returning only values that satisfy the filter function > non-empty list', fn (t) {
    let list: Array[Int] = [1, 2, 3, 5]

    t.equal(filter(list, fn (x) { x % 2 == 1 }), [1, 3, 5])
  })
  t.test('returns the length of a list > empty list', fn (t) {
    let list: Array[Int] = []

    t.equal(length(list), 0)
  })
  t.test('returns the length of a list > non-empty list', fn (t) {
    let list: Array[Int] = [1, 2, 3, 4]

    t.equal(length(list), 4)
  })
  t.test('return a list of elements whose values equal the list value transformed by the mapping function > empty list', fn (t) {
    let list: Array[Int] = []

    t.equal(map(list, fn (x) { x + 1 }), [])
  })
  t.test('return a list of elements whose values equal the list value transformed by the mapping function > non-empty list', fn (t) {
    let list: Array[Int] = [1, 3, 5, 7]

    t.equal(map(list, fn (x) { x + 1 }), [2, 4, 6, 8])
  })
  t.test('folds (reduces) the given list from the left with a function > empty list', fn (t) {
    let list: Array[Int] = []

    t.equal(foldl(list, 2, fn (acc, el) { el * acc }), 2)
  })
  t.test('folds (reduces) the given list from the left with a function > direction independent function applied to non-empty list', fn (t) {
    let list: Array[Int] = [1, 2, 3, 4]

    t.equal(foldl(list, 5, fn (acc, el) { el + acc }), 15)
  })
  t.test('folds (reduces) the given list from the left with a function > direction dependent function applied to non-empty list', fn (t) {
    let list: Array[Float] = [1.0, 2.0, 3.0, 4.0]

    t.equal(foldl(list, 24.0, fn (acc, el) { el / acc }), 64.0)
  })
  t.test('folds (reduces) the given list from the right with a function > empty list', fn (t) {
    let list: Array[Int] = []

    t.equal(foldr(list, 2, fn (acc, el) { el * acc }), 2)
  })
  t.test('folds (reduces) the given list from the right with a function > direction independent function applied to non-empty list', fn (t) {
    let list: Array[Int] = [1, 2, 3, 4]

    t.equal(foldr(list, 5, fn (acc, el) { el + acc }), 15)
  })
  t.test('folds (reduces) the given list from the right with a function > direction dependent function applied to non-empty list', fn (t) {
    let list: Array[Float] = [1.0, 2.0, 3.0, 4.0]

    t.equal(foldr(list, 24.0, fn (acc, el) { el / acc }), 9.0)
  })
  t.test('reverse the elements of the list > empty list', fn (t) {
    let list: Array[Int] = []

    t.equal(reverse(list), [])
  })
  t.test('reverse the elements of the list > non-empty even-length list', fn (t) {
    let list: Array[Int] = [1, 3, 5, 7]

    t.equal(reverse(list), [7, 5, 3, 1])
  })
  t.test('reverse the elements of the list > non-empty odd-length list', fn (t) {
    let list: Array[Int] = [1, 3, 5, 7, 9, 11, 13]

    t.equal(reverse(list), [13, 11, 9, 7, 5, 3, 1])
  })
  t.test('reverse the elements of the list > list of lists is not flattened', fn (t) {
    let list: Array[Array[Int]] = [[1, 2], [3], [], [4, 5, 6]]

    t.equal(reverse(list), [[4, 5, 6], [], [3], [1, 2]])
  })
}
