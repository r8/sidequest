import raindrops (convert)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('the sound for 1 is 1', fn (t) { t.equal(convert(1), '1') })
  t.test('the sound for 3 is Pling', fn (t) { t.equal(convert(3), 'Pling') })
  t.test('the sound for 5 is Plang', fn (t) { t.equal(convert(5), 'Plang') })
  t.test('the sound for 7 is Plong', fn (t) { t.equal(convert(7), 'Plong') })
  t.test('the sound for 6 is Pling as it has a factor 3', fn (t) { t.equal(convert(6), 'Pling') })
  t.test('2 to the power 3 does not make a raindrop sound as 3 is the exponent not the base', fn (t) { t.equal(convert(8), '8') })
  t.test('the sound for 9 is Pling as it has a factor 3', fn (t) { t.equal(convert(9), 'Pling') })
  t.test('the sound for 10 is Plang as it has a factor 5', fn (t) { t.equal(convert(10), 'Plang') })
  t.test('the sound for 14 is Plong as it has a factor of 7', fn (t) { t.equal(convert(14), 'Plong') })
  t.test('the sound for 15 is PlingPlang as it has factors 3 and 5', fn (t) { t.equal(convert(15), 'PlingPlang') })
  t.test('the sound for 21 is PlingPlong as it has factors 3 and 7', fn (t) { t.equal(convert(21), 'PlingPlong') })
  t.test('the sound for 25 is Plang as it has a factor 5', fn (t) { t.equal(convert(25), 'Plang') })
  t.test('the sound for 27 is Pling as it has a factor 3', fn (t) { t.equal(convert(27), 'Pling') })
  t.test('the sound for 35 is PlangPlong as it has factors 5 and 7', fn (t) { t.equal(convert(35), 'PlangPlong') })
  t.test('the sound for 49 is Plong as it has a factor 7', fn (t) { t.equal(convert(49), 'Plong') })
  t.test('the sound for 52 is 52', fn (t) { t.equal(convert(52), '52') })
  t.test('the sound for 105 is PlingPlangPlong as it has factors 3, 5 and 7', fn (t) { t.equal(convert(105), 'PlingPlangPlong') })
  t.test('the sound for 3125 is Plang as it has a factor 5', fn (t) { t.equal(convert(3125), 'Plang') })
}
