import std.cmp (Ordering)

let STRAIGHT_FLUSH = 8
let FOUR_OF_A_KIND = 7
let FULL_HOUSE = 6
let FLUSH = 5
let STRAIGHT = 4
let THREE_OF_A_KIND = 3
let TWO_PAIR = 2
let ONE_PAIR = 1
let HIGH_CARD = 0

# Returns the rank of a card from its first byte and its size.
fn rank(first: Int, size: Int) -> Int {
  if size == 3 { return 10 }

  match first {
    case 74 -> 11 # 'J'
    case 81 -> 12 # 'Q'
    case 75 -> 13 # 'K'
    case 65 -> 14 # 'A'
    case digit -> digit - 48
  }
}

# Returns a key that orders hands by strength: the hand's category, followed by
# its ranks grouped by how often they occur, most frequent and highest first.
fn strength(hand: String) -> Array[Int] {
  let ranks = []
  let suits = []

  for card in hand.split(' ') {
    ranks.push(rank(card.get(0).or_panic, card.size))
    suits.push(card.get(card.size - 1).or_panic)
  }

  # (count, rank) pairs, most frequent and highest first.
  let groups = 2
    .to(14)
    .iter
    .map(fn (r) { (ranks.iter.select(fn (other) { other == r }).count, r) })
    .select(fn (pair) { pair.0 > 0 })
    .to_array

  groups.sort_by(fn (a, b) {
    match b.0.cmp(a.0) {
      case Equal -> b.1.cmp(a.1)
      case order -> order
    }
  })

  let mut order = groups.iter.map(fn (pair) { pair.1 }).to_array
  let counts = groups.iter.map(fn (pair) { pair.0 }).to_array
  let flush = suits.iter.all?(fn (suit) { suit == suits.get(0).or_panic })

  # An ace may start a straight, as the lowest card.
  if order == [14, 5, 4, 3, 2] { order = [5, 4, 3, 2, 1] }

  let straight = order.size == 5
    and order.get(0).or_panic - order.get(4).or_panic == 4
  let category = if straight and flush {
    STRAIGHT_FLUSH
  } else if counts == [4, 1] {
    FOUR_OF_A_KIND
  } else if counts == [3, 2] {
    FULL_HOUSE
  } else if flush {
    FLUSH
  } else if straight {
    STRAIGHT
  } else if counts == [3, 1, 1] {
    THREE_OF_A_KIND
  } else if counts == [2, 2, 1] {
    TWO_PAIR
  } else if counts == [2, 1, 1, 1] {
    ONE_PAIR
  } else {
    HIGH_CARD
  }

  let key = [category]

  key.append(order)
  key
}

# Compares two strength keys element by element.
fn compare(a: ref Array[Int], b: ref Array[Int]) -> Ordering {
  for (x, y) in a.iter.zip(b.iter) {
    match x.cmp(y) {
      case Equal -> {}
      case order -> return order
    }
  }

  a.size.cmp(b.size)
}

# Returns the winning hands among `hands`, in their original order: one hand,
# or several when they tie.
#
# A hand is five space-separated cards, each a rank (`2` to `10`, `J`, `Q`, `K`
# or `A`) followed by a suit (`C`, `D`, `H` or `S`), for example
# `"4S 5S 7H 8D JC"`.
fn pub best_hands(hands: Array[String]) -> Array[String] {
  let keys = hands.iter.map(fn (hand) { strength(hand) }).to_array
  let best = keys.iter.reduce([], fn (best, key) {
    match compare(key, best) {
      case Greater -> key.clone
      case _ -> best
    }
  })

  hands
    .iter
    .zip(keys.iter)
    .select(fn (pair) { pair.1 == best })
    .map(fn (pair) { pair.0 })
    .to_array
}
