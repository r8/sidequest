import leap (leap_year?)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('year not divisible by 4 in common year', fn (t) { t.false(leap_year?(2015)) })
  t.test('year divisible by 2, not divisible by 4 in common year', fn (t) { t.false(leap_year?(1970)) })
  t.test('year divisible by 4, not divisible by 100 in leap year', fn (t) { t.true(leap_year?(1996)) })
  t.test('year divisible by 4 and 5 is still a leap year', fn (t) { t.true(leap_year?(1960)) })
  t.test('year divisible by 100, not divisible by 400 in common year', fn (t) { t.false(leap_year?(2100)) })
  t.test('year divisible by 100 but not by 3 is still not a leap year', fn (t) { t.false(leap_year?(1900)) })
  t.test('year divisible by 400 is leap year', fn (t) { t.true(leap_year?(2000)) })
  t.test('year divisible by 400 but not by 125 is still a leap year', fn (t) { t.true(leap_year?(2400)) })
  t.test('year divisible by 200, not divisible by 400 in common year', fn (t) { t.false(leap_year?(1800)) })
}
