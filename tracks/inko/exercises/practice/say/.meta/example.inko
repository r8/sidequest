let SMALL = [
  'zero',
  'one',
  'two',
  'three',
  'four',
  'five',
  'six',
  'seven',
  'eight',
  'nine',
  'ten',
  'eleven',
  'twelve',
  'thirteen',
  'fourteen',
  'fifteen',
  'sixteen',
  'seventeen',
  'eighteen',
  'nineteen',
]
let TENS = [
  '',
  '',
  'twenty',
  'thirty',
  'forty',
  'fifty',
  'sixty',
  'seventy',
  'eighty',
  'ninety',
]
let SCALES = [1_000_000_000, 1_000_000, 1_000]
let SCALE_NAMES = ['billion', 'million', 'thousand']

# Returns `number` spelled out in English, or an error if it is below zero or
# above 999,999,999,999.
fn pub say(number: Int) -> Result[String, String] {
  if number < 0 or number > 999_999_999_999 {
    return Result.Error('input out of range')
  }

  if number == 0 { return Result.Ok('zero') }

  let words = []
  let mut rest = number

  for (scale, name) in SCALES.iter.zip(SCALE_NAMES.iter) {
    let chunk = rest / scale

    if chunk > 0 { words.push('${below_thousand(chunk)} ${name}') }

    rest = rest % scale
  }

  if rest > 0 { words.push(below_thousand(rest)) }

  Result.Ok(String.join(words.into_iter, ' '))
}

fn below_thousand(number: Int) -> String {
  let words = []
  let rest = number % 100

  if number >= 100 { words.push('${SMALL.get(number / 100).or_panic} hundred') }

  if rest >= 20 {
    let tens = TENS.get(rest / 10).or_panic

    words.push(
      if rest % 10 == 0 {
        tens.clone
      } else {
        '${tens}-${SMALL.get(rest % 10).or_panic}'
      },
    )
  } else if rest > 0 {
    words.push(SMALL.get(rest).or_panic.clone)
  }

  String.join(words.into_iter, ' ')
}
