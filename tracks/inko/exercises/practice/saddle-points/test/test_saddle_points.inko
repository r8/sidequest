import saddle_points (saddle_points)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('Can identify single saddle point', fn (t) {
    t.equal(saddle_points([[9, 8, 7], [5, 3, 2], [6, 6, 7]]), [(2, 1)])
  })
  t.test('Can identify that empty matrix has no saddle points', fn (t) {
    t.equal(saddle_points([[]]), [])
  })
  t.test('Can identify lack of saddle points when there are none', fn (t) {
    t.equal(saddle_points([[1, 2, 3], [3, 1, 2], [2, 3, 1]]), [])
  })
  t.test('Can identify multiple saddle points in a column', fn (t) {
    t.equal(
      saddle_points([[4, 5, 4], [3, 5, 5], [1, 5, 4]]),
      [(1, 2), (2, 2), (3, 2)],
    )
  })
  t.test('Can identify multiple saddle points in a row', fn (t) {
    t.equal(
      saddle_points([[6, 7, 8], [5, 5, 5], [7, 5, 6]]),
      [(2, 1), (2, 2), (2, 3)],
    )
  })
  t.test('Can identify saddle point in bottom right corner', fn (t) {
    t.equal(saddle_points([[8, 7, 9], [6, 7, 6], [3, 2, 5]]), [(3, 3)])
  })
  t.test('Can identify saddle points in a non square matrix', fn (t) {
    t.equal(saddle_points([[3, 1, 3], [3, 2, 4]]), [(1, 1), (1, 3)])
  })
  t.test(
    'Can identify that saddle points in a single column matrix are those with the minimum value',
    fn (t) { t.equal(saddle_points([[2], [1], [4], [1]]), [(2, 1), (4, 1)]) },
  )
  t.test(
    'Can identify that saddle points in a single row matrix are those with the maximum value',
    fn (t) { t.equal(saddle_points([[2, 5, 3, 5]]), [(1, 2), (1, 4)]) },
  )
}
