# Returns the saddle points of `matrix` as `(row, column)` pairs, counting rows
# and columns from 1. The points are sorted by row, then by column.
#
# A saddle point is greater than or equal to every value in its row, and less
# than or equal to every value in its column.
fn pub saddle_points(matrix: Array[Array[Int]]) -> Array[(Int, Int)] {
  let points = []

  for (r, row) in matrix.iter.with_index {
    for (c, value) in row.iter.with_index {
      let tallest = row.iter.all?(fn (other) { other <= value })
      let shortest = matrix.iter.all?(fn (other) {
        other.get(c).or_panic >= value
      })

      if tallest and shortest { points.push((r + 1, c + 1)) }
    }
  }

  points
}
