import pig_latin (translate)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('ay is added to words that start with vowels > word beginning with a', fn (t) { t.equal(translate('apple'), 'appleay') })
  t.test('ay is added to words that start with vowels > word beginning with e', fn (t) { t.equal(translate('ear'), 'earay') })
  t.test('ay is added to words that start with vowels > word beginning with i', fn (t) { t.equal(translate('igloo'), 'iglooay') })
  t.test('ay is added to words that start with vowels > word beginning with o', fn (t) { t.equal(translate('object'), 'objectay') })
  t.test('ay is added to words that start with vowels > word beginning with u', fn (t) { t.equal(translate('under'), 'underay') })
  t.test('ay is added to words that start with vowels > word beginning with a vowel and followed by a qu', fn (t) { t.equal(translate('equal'), 'equalay') })
  t.test('first letter and ay are moved to the end of words that start with consonants > word beginning with p', fn (t) { t.equal(translate('pig'), 'igpay') })
  t.test('first letter and ay are moved to the end of words that start with consonants > word beginning with k', fn (t) { t.equal(translate('koala'), 'oalakay') })
  t.test('first letter and ay are moved to the end of words that start with consonants > word beginning with x', fn (t) { t.equal(translate('xenon'), 'enonxay') })
  t.test('first letter and ay are moved to the end of words that start with consonants > word beginning with q without a following u', fn (t) { t.equal(translate('qat'), 'atqay') })
  t.test('first letter and ay are moved to the end of words that start with consonants > word beginning with consonant and vowel containing qu', fn (t) { t.equal(translate('liquid'), 'iquidlay') })
  t.test('some letter clusters are treated like a single consonant > word beginning with ch', fn (t) { t.equal(translate('chair'), 'airchay') })
  t.test('some letter clusters are treated like a single consonant > word beginning with qu', fn (t) { t.equal(translate('queen'), 'eenquay') })
  t.test('some letter clusters are treated like a single consonant > word beginning with qu and a preceding consonant', fn (t) { t.equal(translate('square'), 'aresquay') })
  t.test('some letter clusters are treated like a single consonant > word beginning with th', fn (t) { t.equal(translate('therapy'), 'erapythay') })
  t.test('some letter clusters are treated like a single consonant > word beginning with thr', fn (t) { t.equal(translate('thrush'), 'ushthray') })
  t.test('some letter clusters are treated like a single consonant > word beginning with sch', fn (t) { t.equal(translate('school'), 'oolschay') })
  t.test('some letter clusters are treated like a single vowel > word beginning with yt', fn (t) { t.equal(translate('yttria'), 'yttriaay') })
  t.test('some letter clusters are treated like a single vowel > word beginning with xr', fn (t) { t.equal(translate('xray'), 'xrayay') })
  t.test('position of y in a word determines if it is a consonant or a vowel > y is treated like a consonant at the beginning of a word', fn (t) { t.equal(translate('yellow'), 'ellowyay') })
  t.test('position of y in a word determines if it is a consonant or a vowel > y is treated like a vowel at the end of a consonant cluster', fn (t) { t.equal(translate('rhythm'), 'ythmrhay') })
  t.test('position of y in a word determines if it is a consonant or a vowel > y as second letter in two letter word', fn (t) { t.equal(translate('my'), 'ymay') })
  t.test('phrases are translated > a whole phrase', fn (t) { t.equal(translate('quick fast run'), 'ickquay astfay unray') })
  # Not in the canonical data: words are separated by any whitespace, which the translation keeps.
  t.test('spacing between words is kept', fn (t) { t.equal(translate('my  dog\tquick'), 'ymay  ogday\tickquay') })
}
