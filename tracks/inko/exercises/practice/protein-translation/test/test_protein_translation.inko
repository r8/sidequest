import protein_translation (proteins)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('Empty RNA sequence results in no proteins', fn (t) { t.equal(proteins(''), Result.Ok([])) })
  t.test('Methionine RNA sequence', fn (t) { t.equal(proteins('AUG'), Result.Ok(['Methionine'])) })
  t.test('Phenylalanine RNA sequence 1', fn (t) { t.equal(proteins('UUU'), Result.Ok(['Phenylalanine'])) })
  t.test('Phenylalanine RNA sequence 2', fn (t) { t.equal(proteins('UUC'), Result.Ok(['Phenylalanine'])) })
  t.test('Leucine RNA sequence 1', fn (t) { t.equal(proteins('UUA'), Result.Ok(['Leucine'])) })
  t.test('Leucine RNA sequence 2', fn (t) { t.equal(proteins('UUG'), Result.Ok(['Leucine'])) })
  t.test('Serine RNA sequence 1', fn (t) { t.equal(proteins('UCU'), Result.Ok(['Serine'])) })
  t.test('Serine RNA sequence 2', fn (t) { t.equal(proteins('UCC'), Result.Ok(['Serine'])) })
  t.test('Serine RNA sequence 3', fn (t) { t.equal(proteins('UCA'), Result.Ok(['Serine'])) })
  t.test('Serine RNA sequence 4', fn (t) { t.equal(proteins('UCG'), Result.Ok(['Serine'])) })
  t.test('Tyrosine RNA sequence 1', fn (t) { t.equal(proteins('UAU'), Result.Ok(['Tyrosine'])) })
  t.test('Tyrosine RNA sequence 2', fn (t) { t.equal(proteins('UAC'), Result.Ok(['Tyrosine'])) })
  t.test('Cysteine RNA sequence 1', fn (t) { t.equal(proteins('UGU'), Result.Ok(['Cysteine'])) })
  t.test('Cysteine RNA sequence 2', fn (t) { t.equal(proteins('UGC'), Result.Ok(['Cysteine'])) })
  t.test('Tryptophan RNA sequence', fn (t) { t.equal(proteins('UGG'), Result.Ok(['Tryptophan'])) })
  t.test('STOP codon RNA sequence 1', fn (t) { t.equal(proteins('UAA'), Result.Ok([])) })
  t.test('STOP codon RNA sequence 2', fn (t) { t.equal(proteins('UAG'), Result.Ok([])) })
  t.test('STOP codon RNA sequence 3', fn (t) { t.equal(proteins('UGA'), Result.Ok([])) })
  t.test('Sequence of two protein codons translates into proteins', fn (t) { t.equal(proteins('UUUUUU'), Result.Ok(['Phenylalanine', 'Phenylalanine'])) })
  t.test('Sequence of two different protein codons translates into proteins', fn (t) { t.equal(proteins('UUAUUG'), Result.Ok(['Leucine', 'Leucine'])) })
  t.test('Translate RNA strand into correct protein list', fn (t) {
    t.equal(proteins('AUGUUUUGG'), Result.Ok(['Methionine', 'Phenylalanine', 'Tryptophan']))
  })
  t.test('Translation stops if STOP codon at beginning of sequence', fn (t) { t.equal(proteins('UAGUGG'), Result.Ok([])) })
  t.test('Translation stops if STOP codon at end of two-codon sequence', fn (t) { t.equal(proteins('UGGUAG'), Result.Ok(['Tryptophan'])) })
  t.test('Translation stops if STOP codon at end of three-codon sequence', fn (t) { t.equal(proteins('AUGUUUUAA'), Result.Ok(['Methionine', 'Phenylalanine'])) })
  t.test('Translation stops if STOP codon in middle of three-codon sequence', fn (t) { t.equal(proteins('UGGUAGUGG'), Result.Ok(['Tryptophan'])) })
  t.test('Translation stops if STOP codon in middle of six-codon sequence', fn (t) {
    t.equal(proteins('UGGUGUUAUUAAUGGUUU'), Result.Ok(['Tryptophan', 'Cysteine', 'Tyrosine']))
  })
  t.test('Sequence of two non-STOP codons does not translate to a STOP codon', fn (t) { t.equal(proteins('AUGAUG'), Result.Ok(['Methionine', 'Methionine'])) })
  t.test("Unknown amino acids, not part of a codon, can't translate", fn (t) { t.equal(proteins('XYZ'), Result.Error('Invalid codon')) })
  t.test("Incomplete RNA sequence can't translate", fn (t) { t.equal(proteins('AUGU'), Result.Error('Invalid codon')) })
  t.test('Incomplete RNA sequence can translate if valid until a STOP codon', fn (t) { t.equal(proteins('UUCUUCUAAUGGU'), Result.Ok(['Phenylalanine', 'Phenylalanine'])) })
}
