import phone_number (clean)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('cleans the number', fn (t) { t.equal(clean('(223) 456-7890'), Result.Ok('2234567890')) })
  t.test('cleans numbers with dots', fn (t) { t.equal(clean('223.456.7890'), Result.Ok('2234567890')) })
  t.test('cleans numbers with multiple spaces', fn (t) { t.equal(clean('223 456   7890   '), Result.Ok('2234567890')) })
  t.test('invalid when 9 digits', fn (t) { t.equal(clean('123456789'), Result.Error('must not be fewer than 10 digits')) })
  t.test('invalid when 11 digits does not start with a 1', fn (t) { t.equal(clean('22234567890'), Result.Error('11 digits must start with 1')) })
  t.test('valid when 11 digits and starting with 1', fn (t) { t.equal(clean('12234567890'), Result.Ok('2234567890')) })
  t.test('valid when 11 digits and starting with 1 even with punctuation', fn (t) { t.equal(clean('+1 (223) 456-7890'), Result.Ok('2234567890')) })
  t.test('invalid when more than 11 digits', fn (t) { t.equal(clean('321234567890'), Result.Error('must not be greater than 11 digits')) })
  t.test('invalid with letters', fn (t) { t.equal(clean('523-abc-7890'), Result.Error('letters not permitted')) })
  t.test('invalid with punctuations', fn (t) { t.equal(clean('523-@:!-7890'), Result.Error('punctuations not permitted')) })
  t.test('invalid if area code starts with 0', fn (t) { t.equal(clean('(023) 456-7890'), Result.Error('area code cannot start with zero')) })
  t.test('invalid if area code starts with 1', fn (t) { t.equal(clean('(123) 456-7890'), Result.Error('area code cannot start with one')) })
  t.test('invalid if exchange code starts with 0', fn (t) { t.equal(clean('(223) 056-7890'), Result.Error('exchange code cannot start with zero')) })
  t.test('invalid if exchange code starts with 1', fn (t) { t.equal(clean('(223) 156-7890'), Result.Error('exchange code cannot start with one')) })
  t.test('invalid if area code starts with 0 on valid 11-digit number', fn (t) { t.equal(clean('1 (023) 456-7890'), Result.Error('area code cannot start with zero')) })
  t.test('invalid if area code starts with 1 on valid 11-digit number', fn (t) { t.equal(clean('1 (123) 456-7890'), Result.Error('area code cannot start with one')) })
  t.test('invalid if exchange code starts with 0 on valid 11-digit number', fn (t) { t.equal(clean('1 (223) 056-7890'), Result.Error('exchange code cannot start with zero')) })
  t.test('invalid if exchange code starts with 1 on valid 11-digit number', fn (t) { t.equal(clean('1 (223) 156-7890'), Result.Error('exchange code cannot start with one')) })
}
