import secret_handshake (Action, commands)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('wink for 1', fn (t) { t.equal(commands(1), [Action.Wink]) })
  t.test('double blink for 10', fn (t) { t.equal(commands(2), [Action.DoubleBlink]) })
  t.test('close your eyes for 100', fn (t) { t.equal(commands(4), [Action.CloseYourEyes]) })
  t.test('jump for 1000', fn (t) { t.equal(commands(8), [Action.Jump]) })
  t.test('combine two actions', fn (t) { t.equal(commands(3), [Action.Wink, Action.DoubleBlink]) })
  t.test('reverse two actions', fn (t) { t.equal(commands(19), [Action.DoubleBlink, Action.Wink]) })
  t.test('reversing one action gives the same action', fn (t) { t.equal(commands(24), [Action.Jump]) })
  t.test('reversing no actions still gives no actions', fn (t) { t.equal(commands(16), []) })
  t.test('all possible actions', fn (t) {
    t.equal(commands(15), [Action.Wink, Action.DoubleBlink, Action.CloseYourEyes, Action.Jump])
  })
  t.test('reverse all possible actions', fn (t) {
    t.equal(commands(31), [Action.Jump, Action.CloseYourEyes, Action.DoubleBlink, Action.Wink])
  })
  t.test('do nothing for zero', fn (t) { t.equal(commands(0), []) })
}
