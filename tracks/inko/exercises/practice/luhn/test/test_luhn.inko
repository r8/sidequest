import luhn (valid?)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('single digit strings can not be valid', fn (t) { t.false(valid?('1')) })
  t.test('a single zero is invalid', fn (t) { t.false(valid?('0')) })
  t.test('a simple valid SIN that remains valid if reversed', fn (t) { t.true(valid?('059')) })
  t.test('a simple valid SIN that becomes invalid if reversed', fn (t) { t.true(valid?('59')) })
  t.test('a valid Canadian SIN', fn (t) { t.true(valid?('055 444 285')) })
  t.test('invalid Canadian SIN', fn (t) { t.false(valid?('055 444 286')) })
  t.test('invalid credit card', fn (t) { t.false(valid?('8273 1232 7352 0569')) })
  t.test('invalid long number with an even remainder', fn (t) { t.false(valid?('1 2345 6789 1234 5678 9012')) })
  t.test('invalid long number with a remainder divisible by 5', fn (t) { t.false(valid?('1 2345 6789 1234 5678 9013')) })
  t.test('valid number with an even number of digits', fn (t) { t.true(valid?('095 245 88')) })
  t.test('valid number with an odd number of spaces', fn (t) { t.true(valid?('234 567 891 234')) })
  t.test('valid strings with a non-digit added at the end become invalid', fn (t) { t.false(valid?('059a')) })
  t.test('valid strings with punctuation included become invalid', fn (t) { t.false(valid?('055-444-285')) })
  t.test('valid strings with symbols included become invalid', fn (t) { t.false(valid?('055# 444$ 285')) })
  t.test('single zero with space is invalid', fn (t) { t.false(valid?(' 0')) })
  t.test('more than a single zero is valid', fn (t) { t.true(valid?('0000 0')) })
  t.test('input digit 9 is correctly converted to output digit 9', fn (t) { t.true(valid?('091')) })
  t.test('very long input is valid', fn (t) { t.true(valid?('9999999999 9999999999 9999999999 9999999999')) })
  t.test('valid luhn with an odd number of digits and non zero first digit', fn (t) { t.true(valid?('109')) })
  t.test("using ascii value for non-doubled non-digit isn't allowed", fn (t) { t.false(valid?('055b 444 285')) })
  t.test("using ascii value for doubled non-digit isn't allowed", fn (t) { t.false(valid?(':9')) })
  t.test("non-numeric, non-space char in the middle with a sum that's divisible by 10 isn't allowed", fn (t) {
    t.false(valid?('59%59'))
  })
}
