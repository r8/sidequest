import isbn_verifier (valid?)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('valid isbn', fn (t) { t.true(valid?('3-598-21508-8')) })
  t.test('invalid isbn check digit', fn (t) { t.false(valid?('3-598-21508-9')) })
  t.test('valid isbn with a check digit of 10', fn (t) { t.true(valid?('3-598-21507-X')) })
  t.test('check digit is a character other than X', fn (t) { t.false(valid?('3-598-21507-A')) })
  t.test('invalid check digit in isbn is not treated as zero', fn (t) { t.false(valid?('4-598-21507-B')) })
  t.test('invalid character in isbn is not treated as zero', fn (t) { t.false(valid?('3-598-P1581-X')) })
  t.test('X is only valid as a check digit', fn (t) { t.false(valid?('3-598-2X507-9')) })
  t.test('only one check digit is allowed', fn (t) { t.false(valid?('3-598-21508-96')) })
  t.test('X is not substituted by the value 10', fn (t) { t.false(valid?('3-598-2X507-5')) })
  t.test('valid isbn without separating dashes', fn (t) { t.true(valid?('3598215088')) })
  t.test('isbn without separating dashes and X as check digit', fn (t) { t.true(valid?('359821507X')) })
  t.test('isbn without check digit and dashes', fn (t) { t.false(valid?('359821507')) })
  t.test('too long isbn and no dashes', fn (t) { t.false(valid?('3598215078X')) })
  t.test('too short isbn', fn (t) { t.false(valid?('00')) })
  t.test('isbn without check digit', fn (t) { t.false(valid?('3-598-21507')) })
  t.test('check digit of X should not be used for 0', fn (t) { t.false(valid?('3-598-21515-X')) })
  t.test('empty isbn', fn (t) { t.false(valid?('')) })
  t.test('input is 9 characters', fn (t) { t.false(valid?('134456729')) })
  t.test('invalid characters are not ignored after checking length', fn (t) { t.false(valid?('3132P34035')) })
  t.test('invalid characters are not ignored before checking length', fn (t) { t.false(valid?('3598P215088')) })
  t.test('input is too long but contains a valid isbn', fn (t) { t.false(valid?('98245726788')) })
}
