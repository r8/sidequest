import spiral_matrix (spiral_matrix)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('empty spiral', fn (t) { t.equal(spiral_matrix(0), []) })
  t.test('trivial spiral', fn (t) { t.equal(spiral_matrix(1), [[1]]) })
  t.test('spiral of size 2', fn (t) {
    t.equal(spiral_matrix(2), [[1, 2], [4, 3]])
  })
  t.test('spiral of size 3', fn (t) {
    t.equal(spiral_matrix(3), [[1, 2, 3], [8, 9, 4], [7, 6, 5]])
  })
  t.test('spiral of size 4', fn (t) {
    t.equal(
      spiral_matrix(4),
      [[1, 2, 3, 4], [12, 13, 14, 5], [11, 16, 15, 6], [10, 9, 8, 7]],
    )
  })
  t.test('spiral of size 5', fn (t) {
    t.equal(
      spiral_matrix(5),
      [
        [1, 2, 3, 4, 5],
        [16, 17, 18, 19, 6],
        [15, 24, 25, 20, 7],
        [14, 23, 22, 21, 8],
        [13, 12, 11, 10, 9],
      ],
    )
  })
}
