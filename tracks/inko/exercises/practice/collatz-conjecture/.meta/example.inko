# Returns the number of steps it takes `number` to reach 1 under the Collatz
# rules, or an error if `number` isn't positive.
fn pub steps(number: Int) -> Result[Int, String] {
  if number < 1 { return Result.Error('Only positive integers are allowed') }

  let mut current = number
  let mut steps = 0

  while current != 1 {
    current = if current % 2 == 0 { current / 2 } else { current * 3 + 1 }
    steps += 1
  }

  Result.Ok(steps)
}
